quired\",\"txtCardExpired\":\"Unfortunately, the payment info we have on file for you has expired so please enter a current card.\",\"txtTax1\":\"tax\",\"txtPaymentLinkHeader\":\"Just enter your CVV code if the card number and expiration date is accurate. Want to use a new card? Select \u201cEdit my card info\u201d below.\",\"labelTxtStateName\":\"State\",\"txtSelectAll\":\"Select All\",\"txtBasePackageHeader\":\"You had this TV Package\",\"txtAddOnsHeader\":\"You had these add-ons\",\"txtTax\":\"Taxes\",\"txtMakeChanges\":\"Make any changes needed. Note your address should be the address for your method of payment.\",\"txtCloseBtn\":\"Close\",\"txtShopNowLink\":\"Explore options\",\"labelTxtCityName\":\"City\",\"labelCardVisa\":\"Visa\",\"txtPaymentAddressHeader\":\"You're almost there\",\"txtOtherOptionsHeader\":\"Looking for something new?\",\"labelTxtLname\":\"Last name\",\"imagePathAmex\":\"/dtvassets/sales/atttv/logos/amex.svg\",\"txtTaxesFooter\":\"* Taxes are estimates. Prices subject to change based on promotional offer and package updates.\",\"imagePathMasterCard\":\"/dtvassets/sales/atttv/logos/mastercard.svg\",\"labelCardAmex\":\"American Express\",\"txtErrMessageFname2\":\"First name is required\",\"txtUpdatePayment\":\"Update payment info\",\"txtErrMessageFname1\":\"Enter a valid first name. Single space, apostrophe, or hyphen allowed.\",\"txtCancelledSubscription1\":\"Your stream service was canceled on [[DATE]]. Restarting is quick and easy.\",\"txtErrMessageCity2\":\"City is required\",\"txtErrMessageState2\":\"State is required\",\"txtErrMessageCity1\":\"City is not valid.\",\"txtErrMessageState1\":\"State is not valid.\",\"txtErrMessageLname1\":\"Enter a valid last name. Single space, apostrophe, or hyphen allowed.\",\"txtErrMessageLname2\":\"Last name is required\",\"txtDueToday\":\"Due today\",\"labelCardMasterCard\":\"Master Card\",\"txtOrderSummaryHeader\":\"Order summary\"},\"tltCard\":\"RESTART SERVICE\",\"txtCancelledSubscription1\":\"Your service was canceled on [[DATE]]. \",\"roadRunnerReconnectTerms\":{\"submitOrderTnC\":\"submitOrderTnC\",\"genericTnc\":\"offerWtRRLease\",\"autopayTnc\":\"autopayTermsOfService\",\"dtvLeaseAgreement\":\"dtvLeaseAgreement\",\"nbaTnc\":\"nbaOfferText\",\"packageFtTnc\":\"packageTermsWithFreeTrial\",\"packageTermsTnc\":\"Package Terms\",\"genericTextTnc\":\"genericTnC\",\"noOfOrders\":\"1\"},\"txtCardDesc\":\"No problem. You can choose the package you want and start watching today!\",\"roadRunnerReconnectSalesUrl\":\"/reconnect/stream\",\"txtCardDescTaz\":\"\\u003cb\\u003eWant to restart your service?\\u003c/b\\u003e\",\"txtCancelledSubscription2\":\"to view your charges and payment history.\",\"lnkButton\":\"https://tst3.directv.com/stream/reconnect/\",\"roadrunnerReconectModal\":{\"tellMeButtonLink\":\"/addEquipment\",\"modalDesc\":\"Want the very best? Add Gemini Air for just $10 a month. Plug and play. Seamlessly switch between live, On Demand, and streaming. Universal voice remote powered by Google. Up to 4K ultra HD, Bluetooth, and Dolby surround sound. Access thousands of apps.\",\"modalTitle\":\"We\u2019re excited to have you back!\",\"noThanksBtn\":\"No Thanks\",\"modalImg\":\"/dtvassets/global/gemini/GeminiAir_Remote.png\",\"wantReconnectDevice\":\"Do you want to connect with a new device?\",\"tellMeMoreBtn\":\"Tell me more\",\"goButton\":\"Go\"},\"txtCardDescHighlight\":\"Want to restart your service?\"}},\"eddReporting\":{\"title\":\"eddReporting\",\"elements\":{\"pageLoad\":{\"pageId\":{\"lblPendantBanner\":\"Want our best TV experience at no cost? You've been selected for an exclusive trial offer with our new Gemini Air streaming device. Participation is limited, so sign up today!\",\"lblAccountOverview\":\"accountOverview\",\"lblStreamTv\":\"streamTv\",\"lblManageDvr\":\"manageDvr\",\"lblManagePackage\":\"managePackage\",\"lblSupportCard\":\"supportCard\",\"lblPendantBannerLink\":\"sign up today! \"}},\"linkClick\":{\"linkId\":{\"lblAddmoreChannel\":\"addMoreChannels\",\"lblCancelPaymentModal\":\"cancelPaymentInfoModal\",\"lblStartWatching\":\"startWatching\",\"lblClosePaymentModal\":\"closePaymentInfoModal\",\"lblWatchAtt\":\"watchAttTv\",\"lblmanageCloudDvrStms\":\"manageCloudDvrStms\",\"lblmanageDVR\":\"manageCloudDvr\",\"lblOpenPaymentModal\":\"update_openPaymentInfoModal\"}}}},\"deactivatedAccountCard\":{\"title\":\"deactivatedAccountCard\",\"elements\":{\"txtCardDesc\":\"Your DIRECTV account is currently deactivated. If you would like to resume your service, please call us at 800.531.5000\",\"tltCard\":\"ACCOUNT DEACTIVATED\"}},\"pageAlerts\":{\"title\":\"pageAlerts\",\"elements\":{\"txtSuccessMessage\":\"Your payment info has been updated!\",\"errSnagMsg\":\"Something went wrong. Please try again..\",\"txtSignUpLink\":\"sign up today!\",\"txtLess\":\" Less\",\"rebateCampaignList\":\"SPORT-NFL,SPORT-COVID,TENFT_DEV,SEL_TO_ENT,STREAM_GIFT,ASTREAM_STAKE,MGM_STREAM1,MGM_STREAM2,FIRST_LAUNCH,LAS_VEGAS,ASTREAM_STAKE2,ALLSTAR_SSTAKE,ALLSTAR_SSTAKE2,NFL_CREDIT\",\"specialMessagesForCustomer\":{\"ALLSTAR_SSTAKE2\":{\"showRemoveIcon\":\"true\",\"id\":\"allstar_stream_stake2\",\"message\":\"\\u003cspan style=\\\"margin: 0\\\"\\u003e\\u003cstrong\\u003eParamount+ with SHOWTIME has it all!\\u003c/strong\\u003e Stream hit series like Halo and so much more with access to the Paramount+ app at no additional charge. \\u003ca href=\\\"https://www.directv.com/accounts/stream/packages?tabValue=premiums\\u0026utm_source=DTV+Internal\\u0026utm_medium=AO+Banner\\u0026utm_campaign=Showtime\\u0026utm_content=AddNow2CTA\\\" aria-label=\\\"AO-Banner\\\" target=\\\"_self\\\"\\u003eAdd now\\u003c/a\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"SPORT-NFL\":{\"showRemoveIcon\":\"true\",\"id\":\"sport-nfl\",\"message\":\"\\u003cspan style=\\\"margin: 0;\\\"\\u003e\\u003cstrong\\u003eYou just scored NFL SUNDAY TICKET MAX on us!\\u003c/strong\\u003e It\u2019s your gift for being a loyal customer\u2014and there\u2019s nothing to do. Just lace up and get ready for the start of the NFL season that kicks off September 11, 2022!\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"MGM_STREAM1\":{\"showRemoveIcon\":\"true\",\"id\":\"mgm_stream1\",\"message\":\"\\u003cspan style='margin: 0'\\u003e\\u003cstrong\\u003eWin DIRECTV for life!\\u003c/strong\\u003e Enter now through 3/31\u2014all part of DIRECTV PERKS. No purchase necessary. \\u003cstrong\\u003e\\u003ca href=\\\" https://perks.directv.com/?utm_source=Internet\\u0026utm_medium=AOBanner\\u0026utm_campaign=DIRECTVPERKS\\\" aria-label=\\\"AO-Banner\\\" target=\\\"_blank\\\"\\u003eENTER NOW\\u003c/a\\u003e\\u003c/strong\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"TENFT_DEV\":{\"showRemoveIcon\":\"true\",\"id\":\"tenft_dev\",\"message\":\"\\u003cspan style='margin: 0'\\u003e\\u003cstrong\\u003eElevate your Entertainment!\\u003c/strong\\u003e This summer sit back and enjoy non-stop sports coverage from MBL Network and Tennis Channel and keep the kids engaged with Nick Jr and Nicktoons and so much more when you upgrade to the DIRECTV\u00ae CHOICE package. \\u003ca href=\\\"https://www.directv.com/accounts/stream/packages?utm_source=DTV+Internal\\u0026utm_medium=AO+Banner\\u0026utm_campaign=BasePackageUpgrade+June+2023\\u0026utm_id=CTA\\u0026utm_term=Upgrade+Now\\\" aria-label=\\\"AO-Banner\\\" target=\\\"_self\\\"\\u003eUPGRADE NOW\\u003c/a\\u003e.\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"SEL_TO_ENT\":{\"showRemoveIcon\":\"true\",\"id\":\"sel_to_ent\",\"message\":\"\\u003cspan style='margin: 0'\\u003e\\u003cstrong\\u003eElevate your Entertainment!\\u003c/strong\\u003e This summer sit back and enjoy top movies and shows from The Movie Channel, FX Movie, STARZ Encore, Magnolia Network, Smithsonian Channel and so much more when you upgrade to the DIRECTV\u00ae ULTIMATE package. \\u003ca href=\\\"https://www.directv.com/accounts/stream/packages?utm_source=DTV+Internal\\u0026utm_medium=AO+Banner\\u0026utm_campaign=BasePackageUpgrade+June+2023\\u0026utm_id=Choice+to+Ultimate\\u0026utm_term=Upgrade+Now\\\" aria-label=\\\"AO-Banner\\\" target=\\\"_self\\\"\\u003eUPGRADE NOW\\u003c/a\\u003e.\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"MGM_STREAM2\":{\"showRemoveIcon\":\"true\",\"id\":\"mgm_stream2\",\"message\":\"\\u003cspan style='margin: 0'\\u003e\\u003cstrong\\u003eWin DIRECTV for life!\\u003c/strong\\u003e DIRECTV PERKS members can enter to win a lifetime of sports, premium add-ons, and more! No purchase necessary. \\u003cstrong\\u003e\\u003ca href=\\\" https://perks.directv.com/?utm_source=Internet\\u0026utm_medium=AOBanner\\u0026utm_campaign=DIRECTVPERKS\\\" aria-label=\\\"AO-Banner\\\" target=\\\"_blank\\\"\\u003eENTER NOW\\u003c/a\\u003e\\u003c/strong\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"SPORT-COVID\":{\"showRemoveIcon\":\"false\",\"id\":\"sport-covid\",\"message\":\"Due to COVID-19 sports interruptions, DIRECTV has received rebates from sports networks. We are passing those rebates on to our customers. Look for a one-time credit adjustment in the next 1-2 bill cycles.\",\"genericId\":\"rebate-banner\"},\"ALLSTAR_SSTAKE\":{\"showRemoveIcon\":\"true\",\"id\":\"allstar_stream_stake\",\"message\":\"\\u003cspan style=\\\"margin: 0\\\"\\u003e\\u003cstrong\\u003eParamount+ with SHOWTIME has it all!\\u003c/strong\\u003e Originals, movies, series\u2014plus access to the Paramount+ app at no additional charge! \\u003ca href=\\\"https://www.directv.com/accounts/stream/packages?tabValue=premiums\\u0026utm_source=DTV+Internal\\u0026utm_medium=AO+Banner\\u0026utm_campaign=Showtime\\u0026utm_content=AddNow1CTA\\\" aria-label=\\\"AO-Banner\\\" target=\\\"_self\\\"\\u003eAdd now\\u003c/a\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"LAS_VEGAS\":{\"showRemoveIcon\":\"true\",\"message\":\"\\u003cspan style='margin: 0'\\u003e\\u003cstrong\\u003eCalling all college basketball fans!\\u003c/strong\\u003e Win an ultimate flyaway for 4 to Las Vegas during the March tournament!\\u003cstrong\\u003e Includes travel, hotel, and more from March 16-19.\\u003c/strong\\u003e Ten extra winners will receive food delivery gift cards. \\u003cstrong\\u003eNo purchase necessary.\\u003c/strong\\u003e \\u003cstrong\\u003e\\u003ca href=\\\"https://sweepstakes.directv.com/vegastourney?utm_source=DIRECTVSTREAM\\u0026utm_medium=AOBanner\\\" aria-label=\\\\\\\"AO-Banner\\\\\\\" target=\\\\\\\"_blank\\\\\\\"\\u003eENTER NOW\\u003c/a\\u003e\\u003c/strong\\u003e.\\u003c/span\\u003e\"},\"ASTREAM_STAKE2\":{\"showRemoveIcon\":\"true\",\"id\":\"astream_stake2\",\"message\":\"\\u003cspan style='margin: 0'\\u003eYou're invited! Join our new loyalty program, DIRECTV PERKS to enjoy giveaways, discounts and more! \\u003cstrong\\u003e\\u003ca href=\\\"https://perks.directv.com?utm_source=Internet\\u0026utm_medium=AOBanner\\u0026utm_campaign=DIRECTVPERKS\\\" aria-label=\\\\\\\"AO-Banner\\\\\\\" target=\\\\\\\"_blank\\\\\\\"\\u003eJOIN NOW\\u003c/a\\u003e\\u003c/strong\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"STREAM_GIFT\":{\"showRemoveIcon\":\"true\",\"id\":\"stream_gift\",\"message\":\"\\u003cspan style='margin: 0'\\u003eLearn how to \\u003cstrong\\u003escore up to $500 in eGift cards per year\\u003c/strong\\u003e by referring your friends to DIRECTV! Redemption Req'd. Restr\u2019s apply. \\u003cstrong\\u003e\\u003ca href=\\\"https://referafriend.directv.com/?utm_medium=AOBanner2_source=Internet\\u0026utm\\\" aria-label=\\\\\\\"AO-Banner\\\\\\\" target=\\\\\\\"_blank\\\\\\\"\\u003eLET\u2019S GO\\u003c/a\\u003e\\u003c/strong\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"ASTREAM_STAKE\":{\"showRemoveIcon\":\"true\",\"id\":\"astream_stake\",\"message\":\"\\u003cspan style='margin: 0'\\u003eReady for rewards? Join DIRECTV PERKS, our new loyalty program. Score big\u2014just for \\tbeing the loyal TV lover you already are! \\u003cstrong\\u003e\\u003ca href=\\\"https://perks.directv.com?utm_source=Internet\\u0026utm_medium=AOBanner\\u0026utm_campaign=DIRECTVPERKS\\\" aria-label=\\\\\\\"AO-Banner\\\\\\\" target=\\\\\\\"_blank\\\\\\\"\\u003eLEARN MORE\\u003c/a\\u003e\\u003c/strong\\u003e\\u003c/span\\u003e\",\"genericId\":\"rebate-banner\"},\"FIRST_LAUNCH\":{\"showRemoveIcon\":\"true\",\"message\":\"\\u003cspan style='margin: 0'\\u003eWe've recently launched a new channel called \\u003cstrong\\u003eThe First\\u003c/strong\\u003e that features several of the most influential conservative commentators in media today. It's already live and available to you at no extra charge on \\u003cstrong\\u003eCh. 349\\u003c/strong\\u003e.\\u003c/span\\u003e\"}},\"txtMore\":\"...More\",\"txtGeminiUserMessage\":\"Want our best TV experience at no cost? You've been selected for an exclusive trial offer with our new Gemini Air streaming device. Participation is limited, so\"}},\"myPaymentInfo\":{\"title\":\"myPaymentInfo\",\"elements\":{\"updatepaymentMethod\":{\"txtcardExpiresSoon\":\"Expires soon on [[cardExpiryDate]]\",\"txtpayMethodupdateSuccess\":\"Your payment method is updated. Now, continue to watch your favorite shows, sports, and news.\",\"errPageLevelError\":\"It\u2019s not you, it\u2019s us. We hit a snag and can\u2019t complete your request right now.\",\"txtcardExpired\":\"Expired [[cardExpiryDate]]\",\"errNopayMethodOnFile\":\"No payment method on file.\",\"title\":\"Update payment method\",\"txtcardExpiry\":\"Expires [[cardExpiryDate]]\",\"ctaAdd\":\"ADD\",\"imgNortanImageURL\":\"/acctmgmt/assets/images/getseal.png\",\"smsPayMethodUpdateSuccess\":\"All set! We\u2019ve updated your payment info.\",\"smsRemovePayPalSuccess\":\"All set!  You removed PayPal as a payment method.\",\"txtTermsAndConditionTil\":\"Your suspension and your DIRECTV TECH PROTECT enrollment\",\"errRemovePayPalFailure\":\"It\u2019s not you, it\u2019s us.  We hit a snag and can\u2019t remove your PayPal account right now. Give it some time and try again.\",\"lnkGoToRoku\":\"https://my.roku.com\",\"ctaChange\":\"CHANGE\",\"txtTermsAndCondition\":\" I understand that my DIRECTV TECH PROTECT plan was canceled when my service was suspended. With resumption of my DIRECTV service, I agree to be enrolled in a new DIRECTV TECH PROTECT plan. I understand that there will be a new 30-day waiting period to make claims for breakdown or damage on my new plan. Please agree to the \\u003ca href=\\\"https://www.directv.com/legal/techprotecttermsandconditions/\\\" target=\\\"_blank\\\"\\u003eterms and conditions.\\u003c/a\\u003e.\",\"lnkGoToGooglePlay\":\"https://play.google.com\",\"errPaypalDefaultMsg\":\"It\u2019s not you. It\u2019s us. We hit a snag and can\u2019t complete your request right now. Please try again. If that doesn\u2019t work, try signing out and signing back in again.\",\"expiredMessage\":\"To avoid any service interruptions, we\u2019ll charge your updated payment method for the outstanding balance.\",\"paypal\":{\"txtRemoveModalHeaderWithNoCCT\":\"First, add another payment method\",\"ctaOK\":\"YES, REMOVE PAYPAL\",\"txtRemoveModalContentWithNoCCT\":\"Once you add another way to pay, we can remove this PayPal account. Either add a credit or debit card or sign in to another PayPal account to make it your primary payment method.\",\"txtRemoveModalContentWithCCT\":\"Then, we can remove this PayPal account. Either select your stored credit or debit card or sign in to another PayPal account and make it your primary payment method.\",\"txtRemoveModalHeaderWithCCT\":\"First, select another payment method\",\"txtRemoveHeader\":\"Remove PayPal Account\",\"lblRemoveModalButtonWithCC\":\"Use my credit or debit card\",\"txtRemoveModalBody\":\"Are you sure you want to remove this PayPal account?\",\"ctaLefttBtnTXT\":\"Pay with PayPal\",\"ctaUpdate\":\"Update info at PayPal\",\"txtComeBack\":\"You\u2019ll come back here to finish the update.\",\"lblRemoveModalButtonWithNoCC\":\"Add a credit or debit card\",\"txtUpdate\":\"Let\u2019s go to \\u003cb\\u003ePayPal \\u003c/b\\u003e to make it your primary payment method.\",\"ctaRemove\":\"Remove PayPal\",\"ctaRightBtnTXT\":\"Use my credit or debit card\"},\"txtNortonImageAlt\":\"Norton Secured Powered by Digicert\",\"ctaGoToGooglePlay\":\"GO TO GOOGLE PLAY\",\"errCardDefaultMsg\":\"It\u2019s not you, it\u2019s us. We hit a snag and can\u2019t complete your request right now. Give it some time and try again later.\",\"smsPayMethodUpdateSuccRSN\":\"Just a reminder - your new regional sports fee is [[rsnFee]].\",\"Card\":{\"CardNumber\":{\"errFieldInvalid\":\"Try entering your card number again with no dashes or spaces.\",\"title\":\"Card #\",\"phtForField\":\"Enter up to 19 digits.\",\"errFieldEmpty\":\"This field is required\"},\"CVV\":{\"txtToolTipNonAmex\":\"For Visa, Mastercard, Discover, JCB, and Diners Club, the 3-digit security code is on the back of the card right after the credit card number.\",\"imgToolTipAmexURL\":\"/acctmgmt/assets/images/ccv2-security-amex.png\",\"CvvTooltip\":{\"imgToolTipNonAmexURL\":\"/accounts/stream/logos/ccv2-security.png\",\"imgToolTipAmexURL\":\"/accounts/stream/logos/ccv2-security-amex.png\",\"amexCard\":\"American Express (Front)\",\"NonAmexCards\":\"VISA, Discover, Mastercard \\u0026 JCB (Back)\",\"title\":\"Find your CCV Security Code\"},\"errFieldInvalid\":\"Try entering your security code again.\",\"txtToolTipAmex\":\"For American Express, the 4-digit security code is on the front of the card.\",\"title\":\"CVV\",\"phtForField\":\"CVV\",\"errFieldEmpty\":\"This field is required, must be [[CVV_LENGTH]] numbers\",\"imgToolTip\":\"/acctmgmt/assets/images/ccv2-security.png\"},\"ZIPCode\":{\"errFieldInvalid\":\"Please enter a valid zipcode\",\"title\":\"ZIP Code\",\"phtForField\":\"5 digits\",\"errFieldEmpty\":\"This field is required\"},\"txtDifferentCardAccepted\":\"We accept Visa, Mastercard, American Express, Discover, Diners Club, and JCB cards.\",\"txtCardAccepted\":\"Accepted cards:\",\"CardExpiry\":{\"errMonthEmpty\":\"Select month card expires.\",\"errYearEmpty\":\"Select year card expires.\",\"errMonthInvalid\":\"Select correct month card expires.\",\"errFieldInvalid\":\"Please enter the correct exp date\",\"errYearInvalid\":\"Select correct year card expires.\",\"title\":\"Exp Date\",\"errDateFormat\":\"Expire date should be mm/yy\",\"errFieldEmpty\":\"Please enter a Expire date\"},\"City\":{\"errMinChar\":\"Minimum of 3 characters required\",\"errFieldInvalid\":\"Only alphabetical characters allowed\",\"title\":\"City\",\"phtForField\":\"Enter city name\",\"errFieldEmpty\":\"This field is required\"},\"imgCreditCardMobileURL\":\"/acctmgmt/assets/images/creditcards@2x.png\",\"ctaCancel\":\"CANCEL\",\"BillingAddress\":{\"errMinChar\":\"Must have a minimum of 3 characters\",\"errFieldInvalid\":\"Enter a valid billing address.\",\"title\":\"Billing Address\",\"phtForField\":\"Enter billing address\",\"errFieldEmpty\":\"This field is required\"},\"CardholderName\":{\"errMinChar\":\"Minimum of 3 characters\",\"errFieldInvalid\":\"Be sure to enter your name the way it's shown on your card.\",\"title\":\"Name on card\",\"phtForField\":\"Enter cardholder name\",\"errFieldEmpty\":\"This field is required\"},\"ctaSubmit\":\"SUBMIT\",\"ctaSave\":\"SAVE\",\"State\":{\"title\":\"State\",\"errFieldEmpty\":\"Select state.\"}},\"rokuPaymentMethod\":\"Roku processes your subscription billing. To make a payment go to my.Roku.com.\",\"amazonPaymentMethod\":\"Amazon processes your subscription billing. You may update your payment info at Amazon.\",\"ctaGoToAmazon\":\"GO TO AMAZON\",\"lnkGoToAmazon\":\"https://pay.amazon.com/jr/your-account/ba/B01-0466497-1172590\",\"ctaGoToRoku\":\"GO TO ROKU\",\"googlePlayPaymentMethod\":\"Google Play processes your subscription billing. To make a payment go to play.google.com.\",\"txtMakeItPrimaryPayMethod\":\"Make \\u003cb\\u003e PayPal \\u003c/b\\u003e my primary payment method.\",\"txtAutoPmtMsgCard\":\"Visa Card Ending in[[cardNumberDigits]]\"},\"title\":\"My Payment Info\"}},\"managePauseSubscription\":{\"title\":\"manageSubscription\",\"elements\":{\"removeSubscriptionPause\":{\"modalContent\":\"If you cancel your subscription pause request before the pause start date, your subscription will continue to auto-charge on [[NEXT_BILLING_DATE]]. We\u2019ll charge [[NEXT_BILLING_AMOUNT]] to MasterCard ending in [[CARD_LAST_DIGITS]].\",\"removeSubscriptiom\":\"REMOVE MY SERVICE PAUSE\",\"discalimer\":\"Yes, I understand that after my pause service period is complete, my billing and services will automatically restart. At any time, during the pause period, I can unpause my service.\",\"resumeSubscriptionContent2\":\"\\u003cli\\u003eYour account will auto-charge [[NEXT_BILLING_AMOUNT]] to your [[CARD_TYPE]] ending in [[CARD_LAST_DIGITS]] on [[TODAY_DATE]]. Once your payment is successfully processed, your service will resume. Your new billing date will be the [[day]]\\u003csmall\\u003e[[ordinalPostFix]]\\u003c/small\\u003e of each month.\\u003c/li\\u003e\\u003cbr /\\u003e\\u003cli\\u003eAny changes you made to your TV Package or add-ons during your pause will now take effect.\\u003c/li\\u003e\\u003cbr /\\u003e\\u003cli\\u003eYou\u2019ll be able to access any DVRs you saved before your pause started.\\u003c/li\\u003e\",\"resumeSubscriptionContent4\":\"You understand that your contract term was extended for the length of time your account was paused.\",\"title\":\"Remove my service pause\",\"resumeSubscriptionContent3\":\"\\u003cli\\u003eYou're removing your service pause request.\\u003c/li\\u003e\\u003cbr/\\u003e\\u003cli\\u003eOnce complete, you can make changes to your TV package and add-ons.\\u003c/li\\u003e\\u003cbr/\\u003e\\u003cli\\u003e Once complete, you can order new equipment.\\u003c/li\\u003e\",\"resumeSubscriptionContent6\":\"You understand that the base package price guarantee for your TV services will not be extended while your account is paused.\",\"resumeSubscriptionContent5\":\"You understand that any outstanding payments for device(s) financed through DIRECTV will resume when your service resumes.\",\"keepSubscription\":\"CANCEL\"},\"pauseMySubscription\":{\"extendMyAccountCta\":\"SAVE CHANGES\",\"oneMonth\":\"one month\",\"extendbyTwoMonths\":\"Extend pause for two extra months. Your pause period will end on [[END DATE]]\",\"bannerPauseUpdateMsg\":\"Your TV service pause period has been updated.\",\"pauseMyAccountCta\":\"PAUSE MY SERVICE\",\"period\":\"Service pause options\",\"resumePausedSubscription\":\"I no longer need to pause my service\",\"extendbyOneMonth\":\"Extend pause for one extra month. Your pause will end on [[END DATE]]\",\"isAffirmDeviceDiscalimer\":\"After your pause period ends, your billing and service will resume automatically. Please note, Any active device installments that are financed by affirm would not be paused. You can easily resume your service at any time.\",\"twoMonths\":\"two months\",\"discalimer\":\"After your pause period ends, your billing and service will resume automatically and your payment method on file will be charged the prevailing price at that date. Any remaining promo offer balance will also be applied to your account. You can easily resume your service at any time.\",\"streamDiscalimer\":\"After your pause period ends, your billing and service will resume automatically and your payment method on file will be charged the prevailing price at that date. When the account is reactivated, remaining balances on Base Package and Premiums promotions will be applied. Pausing your account could result in the loss of other promotions or credits (e.g. Video Loyalty Credits). Please call customer service at 800.531.5000 with questions.\",\"isAffirmDeviceExtendDisclaimer\":\"After my pause period ends, my billing and services will automatically restart. Please note, Any active device installments that are financed by affirm would not be paused. I can unpause my service at any time.\",\"txtActivePgOnBg\":\"You understand that the base package price guarantee for your TV services will not be extended while your account is paused.\",\"title\":\"Ready for a pause?\",\"extendDisclaimer\":\"After your pause period ends, billing and services will automatically restart. You can unpause your service at any time.\",\"txtTazContractTerms\":\"You understand that your contract term will be extended for the length of time your account is paused.\",\"noThanksCta\":\"CANCEL\",\"pausePeriodCta\":\"I\u2019d like to pause for:\",\"modalContent\":\"It\u2019s easy to pause your service and billings for one, two, or three months. Your pause starts on the first day of your next billing cycle\u2014service resumes automatically when your pause ends.\",\"extendTitle\":\"Manage my pause\",\"extendModalContent\":\"Your service will pause for [[DURATION]] , from [[START DATE]] to [[END DATE]]. The maximum pause period is three months.\",\"bannerPauseRemoveMsg\":\"Your TV service pause period has been removed.\",\"quitPauseCta\":\"NEXT\"}}},\"accountSuspendedCard\":{\"title\":\"accountSuspendedCard\",\"elements\":{\"ctaButton\":\"UPDATE PAYMENT METHOD\",\"txtMsgPendingPause\":\"At your request, your service will be paused from [[START_DATE]] to [[END_DATE]].\",\"txtCardDesc\":\"Your service is temporarily suspended as we couldn\u2019t process your latest payment. Please update your payment method today to avoid disconnection of your DIRECTV service on [[DISCONNECT_DATE]].\",\"ctaButtonRemovePause\":\"REMOVE MY SERVICE PAUSE\",\"ctaButtonPause\":\"CHANGE MY SERVICE PAUSE\",\"tltCardPause\":\"TV SERVICE PAUSED\",\"txtMsgPause\":\"At your request, your service will resume on [[END_DATE]]\",\"txtCardDescPendingPause\":\"You can keep watching your favorite movies and recordings until the end of your current billing cycle. You can also resume your service at any time.\",\"txtCardDescPause\":\"You can make changes to your service pause at any time. You\u2019ll be auto-charged when the pause period ends.\",\"tltCard\":\"ACCOUNT SUSPENDED\",\"ctaButtonPendingPause\":\"CHANGE MY SERVICE PAUSE\",\"tltCardPendingPause\":\"TV SERVICE PAUSING SOON\"}},\"businessCard\":{\"title\":\"businessCard\",\"elements\":{\"ctaButton\":\"LEARN MORE\",\"ctaDownloadAppstore\":\"DOWNLOAD FROM APP STORE\",\"txtAdditionReqList\":[\"DIRECTV HD Receivers must be Internet-connected (wireless router \\u0026 DIRECTV Ethernet to coax adapter)\",\"The business app is only available for compatible iOS and Android tablets\"],\"txtDownloadOnTab\":{\"appStoreURL\":\"https://apps.apple.com/us/app/id1313561825\",\"playStoreURL\":\"https://play.google.com/store/apps/details?id=com.directv.copilotcommercial\",\"txtPlayStore\":\"Google Play Store\",\"txtInfoOne\":\"Download the Free DIRECTV FOR BUSINESS Remote App on your tablet from the \",\"txtOR\":\" or \",\"txtAppStore\":\"Apple App Store\"},\"txtFeaturesList\":[\"Quickly identify receivers with custom names\",\"See what\u2019s playing on all TVs from one screen\",\"Channel surf using the DIRECTV programming guide\",\"View all current and upcoming sports schedules\",\"Group receivers to change the channel on multiple TVs at once\"],\"tltCard\":\"DIRECTV FOR BUSINESS\\u003csup\\u003eSM\\u003c/sup\\u003e REMOTE APP\",\"imgInfo\":{\"imgGooglePlay\":\"/dtvassets/forbusiness/ao/google-play-badge.png\",\"imgAppStoreAlt\":\"Download on the App Store\",\"imgRemoteApp\":\"/dtvassets/forbusiness/ao/dtvbiz-iPadx2.jpg\",\"imgDtvBusinessLogo\":\"/dtvassets/forbusiness/ao/logo-dtvbiz.svg\",\"imgAppStore\":\"/dtvassets/forbusiness/ao/apple-app-store-badge.png\",\"imgGooglePlayAlt\":\"Get it on Google Play\"},\"ctaLearnMore\":\"Learn more\",\"txtSignInOnApp\":\"Sign-in to the app\",\"txt\":\"From the tablet, LAUNCH the DIRECTV for BUSINESS Remote App. Enter the email address and password that was registered on directv.com/register and SIGN IN\",\"txtJustaReminder\":\"Just a reminder:\",\"txtGetStarted\":\"Get started using your Tablet as a remote\",\"tltRemoteCardInfo\":\"The DIRECTV FOR BUSINESS\\u003csup\\u003eSM\\u003c/sup\\u003e Remote App gives you control over all of your DIRECTV\u00ae Receivers from just one tablet.\",\"tltRemoteApp\":\"DIRECTV FOR BUSINESS\\u003csup\\u003eSM\\u003c/sup\\u003e REMOTE APP gives business customers control of all their DIRECTV\u00ae Receivers from just one tablet (iOS or Android).\",\"learnMoreGoDigitalUrl\":\"/support/business/article/000092421\",\"ctaGetOnGooglePlay\":\"GET ON GOOGLE PLAY\",\"txtSignInApp\":\"Sign-in to the app\",\"txtLaunchDirectv\":\"From the tablet, launch the DIRECTV FOR BUSINESS Remote App. Enter the email address and password that was registered on directv.com/register and SIGN IN.\",\"txtAdditionalInfo\":\"Certain remote control functions require a standard DIRECTV remote. Tablet remote control functionality requires an Internet or Wi-Fi connection and is limited to the range of network. DIRECTV Receiver(s) and the tablet must be connected to the same network. Charges may apply for an Internet Connection Kit and installation. Requires Internet-connected compatible DIRECTV\u00ae HD Receivers H21, H23, H24, H25, HR20, HR21, HR22, HR23, HR24 or H44. Business accounts are not authorized to access the residential DIRECTV app.\",\"tltRemoteCard\":\"CONTROL ALL YOUR RECEIVERS\"}},\"manageCombineCard\":{\"title\":\"manageCombineCard\",\"elements\":{\"ctaDVRButton\":\"MANAGE CLOUD DVR\",\"ctaWatchButton\":\"WATCH NOW\",\"txtCardDesc\":\"Did you know can edit and delete shows from your cloud DVR? You can also stream your faves right now.\",\"updateAddress\":{\"lblUpdateAddressLink\":\"Update your service address\",\"lnkUpdateAddressLink\":\"/accounts/stream/updateAddress\"},\"lnkDVRButton\":\"https://www.att.tv/library\",\"lnkWatchButton\":\"https://www.att.tv/watchnow\",\"tltCard\":\"WATCH AND RECORD TV\"}},\"techProtectCombineCard\":{\"title\":\"techProtectCombineCard\",\"elements\":{\"imgCardDescAdd\":\"/dtvassets/service/images/TechProtect_card.jpg\",\"txtCardDescExistingBre\":\"Your coverage will be active soon. There\u2019s a 30-day waiting period to make claims for breakdown or damage. Watch your email for your welcome kit from Assurant.\",\"tltCardManage\":\"DIRECTV TECH PROTECT\",\"lnkButtonAdd\":\"Learn more\",\"tltCardExisting\":{\"BOLT-BASEPP-202309\":\"DIRECTV TECH PROTECT\",\"BOLT-PREMIUMPP-202309\":\"DIRECTV TECH PROTECT PREMIUM\"},\"txtCardDescRemoved\":\"PLEASE NOTE: You\u2019ve canceled your DIRECTV TECH PROTECT plan. Your coverage will continue until your billing cycle ends on [[DATE]].\",\"txtCardDescPaused\":\"Your DIRECTV TECH PROTECT plan is currently canceled. You've agreed to be enrolled in a new plan after your pause period ends.\",\"txtCardDescEdit\":\"We\u2019ve got you covered! Your home\u2019s tech is protected\u2014so you can relax and enjoy the show.\",\"txtCardDescExisting\":{\"BOLT-BASEPP-202309\":\"PLEASE NOTE: Technical support and coverage for power surges is active now. Claims for breakdowns and damage can be made after [[DATE]]\",\"BOLT-PREMIUMPP-202309\":\"We\u2019ve got you covered! Technical support is available now. You can make claims on this plan after [[DATE]].\"},\"txtCardDescAdd\":\"Get coverage and expert support for your home\u2019s entertainment gear with DIRECTV TECH PROTECT.\",\"lnkButtonManage\":\"MANAGE TECH PROTECT\",\"txtCardDescSwitch\":\"We\u2019ve got you covered! Support is available now. You can make claims on this plan after [[DATE]].\",\"txtCardDescManage\":\"PLEASE NOTE: Premium support and coverage for power surges is active now. Claims for breakdowns and damage can be made after [[DATE]].\",\"tltCardAdd\":\"Protect your tech\"}},\"loyaltyCard\":{\"title\":\"loyaltyCard\",\"elements\":{\"ctaButton\":\"Learn more\",\"imgUrl\":\"https://www.directv.com/dtvassets/sales/directv/account/loyalty.png\",\"txtCardDesc\":\"The future looks rewarding. Get started with DIRECTV's Loyalty App today.\",\"cardName\":\"LoyaltyCard\",\"lnkButton\":\"https://perks.directv.com/?utm_medium=direct\\u0026utm_source=account+overview+card\\u0026utm_campaign=directv+perks\\u0026utm_audience=existingcustomer\",\"tltCard\":\"Learn more!\"}},\"tileNetworkFailure\":{\"title\":\"tileNetworkFailure\",\"elements\":{\"txtApiFailure\":\"Sorry, we\u2019re unable to load this information at this time. Please try again later.\"}},\"frontPorchCards\":{\"title\":\"frontPorchCards\",\"elements\":{\"freeTvCard\":{\"elements\":{\"freeTvBanner\":{\"ctaButton\":\"Watch now\",\"titleCard\":\"MyFree DIRECTV\",\"description\":\"Enjoy a curated selection of live channels and On Demand content, personalized to your preferences\u2014all for free!\",\"freeTvImg\":\"/dtvassets/service/images/ffp/ffp_bg-under-purple.png\",\"channelbutton\":\"See channel lineup\",\"ctaLink\":\" \",\"channelLineUpLink\":\"/channel-lineup/modal?myFreeDtv=true\"}},\"title\":\"freeTvCard\"},\"infoSupportCard\":{\"elements\":{\"supportBanner\":{\"titleCard\":\"MyFree DIRECTV info and support\",\"watchLink\":\"/support/article/000106897\",\"watchName\":\"How to watch\",\"description\":\"Need help with content, using the app, or other questions? Check out the links below.\",\"faqLink\":\"/support/article/000106898\",\"faqName\":\"MyFree DIRECTV FAQ\"}},\"title\":\"infoSupportCard\"},\"ffpSignUpCards\":{\"elements\":{\"ffpSignUpCard\":{\"ctaButton\":\"Sign up\",\"titleCard\":\"Sign up for MyFree DIRECTV\u2014\\u003cspan class='[[signupTitleColor]]'\\u003ea free premium TV experience\\u003c/span\\u003e\",\"buttonLink\":\"/channel-lineup/?MyFree=true\",\"description\":\"Sign up in seconds for free premium entertainment\u2014no strings attached. Just the perfect mix of top-quality live channels and On Demand, personalized to your preferences.\",\"channelbutton\":\"See channel lineup\",\"bannerImg\":\"/dtvassets/service/images/ffp/ffp_signup_card_mobile.png\"},\"ffpSignUpModal\":{\"ctaButton\":\"Sign up\",\"submitOrderTnC\":\"submitOrderFP\",\"genericTnc\":\"FPTnc\",\"ffpSignUpErrorMessage\":\"There is an error handling your request. Please try again later.\",\"