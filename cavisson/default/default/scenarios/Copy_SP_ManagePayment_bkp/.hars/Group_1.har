mode\":\"\",\"type\":\"\",\"label\":\" Offer details\",\"sizes\":\"\",\"colors\":\"\",\"target\":\"\",\"content\":\"\",\"variant\":\"\",\"legalUrl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"position\":\"inline\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"accessibility\":\"\",\"backgroundColor\":\"\"}],\"_uid\":\"a0d180d6-90f3-451f-b30d-ca54203b5f86\",\"type\":\"\",\"content\":\"*Max, SHOWTIME, STARZ, MGM+ and Cinemax auto-renew after 3 months at then prevailing rates (currently $15.99/mo. for Max, $11.00/mo. each for SHOWTIME, STARZ and Cinemax, and $6.00/mo. for MGM+), unless you change or cancel. Req\u2019s you to select offer. Offer subject to change \\u0026 may be modified or discontinued at any time without notice. Max is used under license. Access Max only through Max app or \\u003ca href=\\\"https://www.max.com/\\\" target=\\\"_blank\\\"\\u003emax.com\\u003c/a\\u003e. Online account registration may be required. Offer not available to DIRECTV via Satellite and U-verse TV customers switching to DIRECTV via Internet.\",\"tooltip\":[],\"position\":\"\",\"component\":\"content_uf\",\"components\":\"\",\"componentType\":\"h4\",\"inlineLinkStyle\":\"\"}],\"textAlign\":\"center\",\"gridColumn\":[]},{\"id\":\"faqPanel\",\"faq\":[{\"_uid\":\"b822b7e2-5afb-42da-9e65-e2da8a20255e\",\"component\":\"FAQ\",\"componentt\":\"h5\",\"INITIALCOUNT\":\"4\",\"array_panels\":[{\"_uid\":\"4c99617b-d19d-40bb-b12f-410b702a7d2c\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"94f32fb0-99fe-4c2b-8bb6-cef3fa2ab088\",\"type\":\"\",\"content\":\"DIRECTV STREAM is a subscription streaming service that lets you watch live TV from major broadcast and popular cable networks. Enjoy local and national live sports, breaking news and must see shows the moment they air. Included: unlimited cloud DVR storage space so you can record as many shows as you want and stream them from wherever you go.\\u003cbr /\\u003e\\u003cbr /\\u003e\\n\\u003cspan style=\\\"font-size: 11.0px;\\\"\\u003eNew DIRECTV STREAM customers only. Offer not available to DIRECTV and U-verse TV customers switching to DIRECTV STREAM. Data connection req\u2019d. Recordings expire after 9 months. In a series recording, max 30 episodes stored (oldest deleted first which may be in less than 9 months). Restr\u2019s apply. \\u003c/span\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"bcb0dfc3-d7ca-4c8b-a5fb-6450972676b1\",\"type\":\"\",\"content\":\"What is DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"3ecac875-42c1-47f9-894a-5ebd38bf500f\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"75b20666-70b5-4840-84a9-901667963c0e\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM gives you live and on demand access to top shows like Yellowstone, The Simpsons, The Walking Dead, Grey\u2019s Anatomy, Sports Center, FOX NFL Sunday, Good Morning America, The Rachel Maddow Show, Atlanta, Dateline, Family Guy, Law \\u0026amp; Order SVU, The Voice... and the list keeps growing.\\u003c/p\\u003e\\n\\u003cp\\u003eFor even more entertainment check out \\u003ca href=\\\"https://www.directv.com/insider/\\\" style=\\\"background-color: rgb(255, 255, 255);\\\"\\u003eDIRECTV Insider\\u003c/a\\u003e where you will get the latest sporting news, exclusive interviews, along with hot trending topics, such as newly released and upcoming movies \\u0026amp; get the latest scoop on TV series, actors, actresses and musicians.\\u003cbr\\u003e\\n\\u003c/p\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"206ea104-c58f-4d48-a297-b2d8ce269c7b\",\"content\":\"What are some shows I can watch on DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"72aa84bc-90c8-4dfd-bc53-5d705a1f6426\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"eacbef0d-2602-4885-a58b-91f7a6767df0\",\"type\":\"\",\"content\":\"To watch Major League Baseball games without cable, just start a free trial of DIRECTV STREAM. You can start watching immediately on your television, phone, computer \\u0026 more by downloading the DIRECTV STREAM app. There is no commitment or contract.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"306b53f6-cad9-49fc-b038-a568917f2615\",\"content\":\"How can I watch the MLB baseball games online without cable?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"28440a40-968d-45b6-9703-60f95c2e6154\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"ca07ca04-29a6-4730-aaa1-3c2931ae819b\",\"type\":\"\",\"content\":\"Absolutely! Not only does DIRECTV STREAM have NFL, NBA, and MLB games, but you can also watch NHL, NASCAR, MLS, golf tennis, boxing, MMA, college sports and more. Plus, we have every major golf, tennis major and Triple Crown races as well as full coverage of specials like the World Series, NBA Finals, Stanley Cup Playoffs and Olympics.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"40da97f1-2d7c-492c-af6d-939cc5dad642\",\"content\":\"Are leagues like the NFL, NBA, MLB and others available? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"c3c4a8ce-fdc2-4420-9b7a-a1036a021400\",\"comp