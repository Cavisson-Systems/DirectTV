tionUrl\":\"\",\"contentFriendlyName\":\"TV-ATTTV-Default-Hero--NBALP-Q2-21\",\"contentProductGroup\":\"ATTTV\"}],\"component\":\"inPageLegal_uf\",\"legalText\":[{\"cta\":[{\"_uid\":\"54a244a1-4d03-43c3-a1c0-14857043b1fd\",\"mode\":\"\",\"type\":\"\",\"label\":\" Offer details\",\"sizes\":\"\",\"colors\":\"\",\"target\":\"\",\"content\":\"\",\"variant\":\"\",\"legalUrl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"position\":\"inline\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"accessibility\":\"\",\"backgroundColor\":\"\"}],\"_uid\":\"e1ccb6d6-7c0d-4fc0-8bbc-e3aa680dafbf\",\"type\":\"\",\"content\":\"*Max, SHOWTIME, STARZ, MGM+ and Cinemax auto-renew after 3 months at then prevailing rates (currently $17.99/mo. for Max, $11.00/mo. each for SHOWTIME, STARZ and Cinemax, and $6.00/mo. for MGM+), unless you change or cancel. Req\u2019s you to select offer. Offer subject to change \\u0026 may be modified or discontinued at any time without notice. Max is used under license. Access Max only through Max app or \\u003ca href=\\\"https://www.max.com/\\\" target=\\\"_blank\\\"\\u003emax.com\\u003c/a\\u003e. Online account registration may be required. Offer not available to DIRECTV via Satellite and U-verse TV customers switching to DIRECTV via Internet.\",\"tooltip\":[],\"position\":\"\",\"component\":\"content_uf\",\"components\":\"\",\"componentType\":\"h4\",\"inlineLinkStyle\":\"\"}],\"textAlign\":\"center\",\"gridColumn\":[]},{\"id\":\"faqPanel\",\"faq\":[{\"_uid\":\"50af5d4a-7557-45e6-9554-c3d096c8072d\",\"component\":\"FAQ\",\"componentt\":\"h5\",\"INITIALCOUNT\":\"4\",\"array_panels\":[{\"_uid\":\"d1f7c3ef-45b9-43b4-a49d-f699dd0be65a\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"627f3478-10c3-4e91-9bda-d5ba1ee3bb1e\",\"type\":\"\",\"content\":\"DIRECTV STREAM is a subscription streaming service that lets you watch live TV from major broadcast and popular cable networks. Enjoy local and national live sports, breaking news and must see shows the moment they air. Included: unlimited cloud DVR storage space so you can record as many shows as you want and stream them from wherever you go.\\u003cbr /\\u003e\\u003cbr /\\u003e\\n\\u003cspan style=\\\"font-size: 11.0px;\\\"\\u003eNew DIRECTV STREAM customers only. Offer not available to DIRECTV and U-verse TV customers switching to DIRECTV STREAM. Data connection req\u2019d. Recordings expire after 9 months. In a series recording, max 30 episodes stored (oldest deleted first which may be in less than 9 months). Restr\u2019s apply. \\u003c/span\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"c51df20a-760c-4b2b-b0dd-50b0d03e3165\",\"type\":\"\",\"content\":\"What is DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"ea42f96e-0c57-4bbb-a38f-89e26ca1ea3a\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"71d993c8-489e-4b6a-a384-0d00c52559cf\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM gives you live and on demand access to top shows like Yellowstone, The Simpsons, The Walking Dead, Grey\u2019s Anatomy, Sports Center, FOX NFL Sunday, Good Morning America, The Rachel Maddow Show, Atlanta, Dateline, Family Guy, Law \\u0026amp; Order SVU, The Voice... and the list keeps growing.\\u003c/p\\u003e\\n\\u003cp\\u003eFor even more entertainment check out \\u003ca href=\\\"https://www.directv.com/insider/\\\" style=\\\"background-color: rgb(255, 255, 255);\\\"\\u003eDIRECTV Insider\\u003c/a\\u003e where you will get the latest sporting news, exclusive interviews, along with hot trending topics, such as newly released and upcoming movies \\u0026amp; get the latest scoop on TV series, actors, actresses and musicians.\\u003cbr\\u003e\\n\\u003c/p\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"3ea4beaf-0734-45dc-acb0-bf48891c7f60\",\"content\":\"What are some shows I can watch on DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"6b956b57-81b8-49ca-a32e-e4e1e7735252\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"981a57a5-530b-48c1-982a-1900bbe05502\",\"type\":\"\",\"content\":\"To watch Major League Baseball games without cable, just start a free trial of DIRECTV STREAM. You can start watching immediately on your television, phone, computer \\u0026 more by downloading the DIRECTV STREAM app. There is no commitment or contract.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"d3837ab9-b22a-4987-a587-8aead7091614\",\"content\":\"How can I watch the MLB baseball games online without cable?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"b42480f9-caee-42c2-9585-93293e7bcc80\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"359c78e6-e0fb-4fea-be4f-f437f14d2a04\",\"type\":\"\",\"content\":\"Absolutely! Not only does DIRECTV STREAM have NFL, NBA, and MLB games, but you can also watch NHL, NASCAR, MLS, golf tennis, boxing, MMA, college sports and more. Plus, we have every major golf, tennis major and Triple Crown races as well as full coverage of specials like the World Series, NBA Finals, Stanley Cup Playoffs and Olympics.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"658fac93-e49d-4307-b4c7-c7a5415b5050\",\"content\":\"Are leagues like the NFL, NBA, MLB and others available? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"3efd65c9-4b70-47f9-95f2-691895406f53\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"188ec9f1-eef7-4b43-a0fd-324a21487db9\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM is available currently in the United States. All packages include cloud DVR storage and there are no hidden fees, equipment rentals or installation appointments required. All that is needed\\u0026nbsp;to get started is:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eA mobile phone number or email address\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA future payment method\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA broadband internet connection\\u0026nbsp;\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA supported streaming device\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"b78f3c0f-7224-4218-af0d-4c022dcdbb21\",\"content\":\"Is DIRECTV STREAM available where I live?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]},{\"_uid\":\"83e7a706-5a89-4028-92fa-9bdd40931e68\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"390b04d5-f440-4844-a625-30482ff78dc9\",\"content\":\"Amazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nAmazon Fire tablets (4th gen or later)\\u003cbr /\\u003e\\nAndroid TV, phones, and tablets (with OS 5 or later)\\u003cbr /\\u003e\\nApple TV (4th gen or later)\\u003cbr /\\u003e\\nApple iPhone, iPad, and iPod Touch (with iOS 12.2 or later)\\u003cbr /\\u003e\\nCox Contour 2 and Contour Stream Player\\u003cbr /\\u003e\\nLG Smart TV (with webOS 4 or later)\\u003cbr /\\u003e\\nMac computers (with macOS X 10.10 or later)\\u003cbr /\\u003e\\nGoogle Chromebooks (with Chrome browser version 95 or later)\\u003cbr /\\u003e\\nGoogle TV\\u003cbr /\\u003e\\nPC (with Windows 7 or later)\\u003cbr /\\u003e\\nPlayStation 4 and 5\\u003cbr /\\u003e\\nRoku streaming devices (with Roku OS 10 or later)\\u003cbr /\\u003e\\nSamsung TV (2016 models and later)\\u003cbr /\\u003e\\nAmazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nSpectrum WorldBox (in select areas)\\u003cbr /\\u003e\\nVIZIO Smart TV (2018 models and later)\\u003cbr /\\u003e\\nXbox One and Xbox Series X|S\\u003cbr /\\u003e\\nXClass TV\\u003cbr /\\u003e\\nXfinity X1 and Flex\\u003cbr /\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"0a02b50a-6101-47b5-b649-f11a1754d42d\",\"content\":\"What is a supported streaming device? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]}],\"ADDITIONALCOUNT\":\"7\"}],\"_uid\":\"7fd9f744-87b2-47d5-96de-8bc81f70c254\",\"type\":\"FAQ\",\"title\":[{\"cta\":[],\"_uid\":\"b2058bc2-9960-4881-9f2b-3a91f335d77e\",\"content\":\"Frequently asked questions\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"spacer\":\"afterHero\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"_uid\":\"3b4b24d5-2d58-45b8-ac7a-1d4cbfcb8650\",\"component\":\"analytics\",\"contentFriendlyName\":\"Frequently asked questions\",\"contentProductGroup\":\"atttv\"}],\"component\":\"faqPanel\",\"primaryCTA\":[{\"_uid\":\"62335750-b355-4532-bcd3-12a711354591\",\"mode\":\"\",\"type\":\"contained\",\"label\":\"\",\"sizes\":\"large\",\"colors\":\"primary\",\"target\":\"\",\"content\":\"VIEW MORE\",\"variant\":\"\",\"legalUrl\":\"\",\"position\":\"\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"\",\"accessibility\":\"View More\",\"backgroundColor\"