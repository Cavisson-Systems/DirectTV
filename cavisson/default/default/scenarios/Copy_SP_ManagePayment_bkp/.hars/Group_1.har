PAGELOADMODAL\",\"component\":\"dtvRevisiterModal\",\"array_modals\":[{\"_uid\":\"262bce68-665e-4b51-9b07-847ac31962eb\",\"component\":\"pageLoadModal\",\"modalType\":\"revisitor\",\"array_modalData\":[{\"_uid\":\"821b0be4-19fe-4ced-86b1-59d00370db5a\",\"mode\":\"\",\"type\":\"heading\",\"label\":\"\",\"content\":\"Pick up where you left off?\",\"variant\":\"\",\"ariaLabel\":\"\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"\"},{\"_uid\":\"67de1cd0-7b80-4488-98f4-58f4b7187475\",\"mode\":\"\",\"type\":\"subHeading\",\"label\":\"\",\"content\":\"Do you want to continue with the choices you made earlier?\",\"variant\":\"\",\"ariaLabel\":\"\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"\"},{\"_uid\":\"2670bcfd-2c47-43fb-84c3-8efad9aeb507\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"Yes, keep my earlier choices\",\"content\":\"\",\"variant\":\"\",\"ariaLabel\":\"Yes, keep my earlier choices\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"anchorLink\"},{\"_uid\":\"431e855d-a57c-4bc1-9333-25ba95e81d17\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"No, I will start over\",\"content\":\"\",\"variant\":\"uxsecondary\",\"ariaLabel\":\"No, I will start over\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"closeModal\"}]}]},{\"id\":\"inPageLegal4-2up\",\"_uid\":\"06cf0c4f-d1d9-4963-982e-c64c2c5057ae\",\"type\":\"INPAGELEGAL\",\"align\":\"center\",\"legalUrl\":\"\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"url\":\"\",\"_uid\":\"e871939b-c0df-4791-a0dc-e6a70b69998f\",\"linkName\":\"\",\"component\":\"analytics_uf\",\"linkPosition\":\"\",\"linkDestinationUrl\":\"\",\"contentFriendlyName\":\"TV-ATTTV-Default-Hero--NBALP-Q2-21\",\"contentProductGroup\":\"ATTTV\"}],\"component\":\"inPageLegal_uf\",\"legalText\":[{\"cta\":[{\"_uid\":\"96f3f5a9-1ffe-4034-89f9-857a36456374\",\"mode\":\"\",\"type\":\"\",\"label\":\" Offer details\",\"sizes\":\"\",\"colors\":\"\",\"target\":\"\",\"content\":\"\",\"variant\":\"\",\"legalUrl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"position\":\"inline\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"accessibility\":\"\",\"backgroundColor\":\"\"}],\"_uid\":\"e2f70136-6c7f-4a93-abf6-ccd1bdd5fd40\",\"type\":\"\",\"content\":\"*Max, SHOWTIME, STARZ, MGM+ and Cinemax auto-renew after 3 months at then prevailing rates (currently $17.99/mo. for Max, $11.00/mo. each for SHOWTIME, STARZ and Cinemax, and $6.00/mo. for MGM+), unless you change or cancel. Req\u2019s you to select offer. Offer subject to change \\u0026 may be modified or discontinued at any time without notice. Max is used under license. Access Max only through Max app or \\u003ca href=\\\"https://www.max.com/\\\" target=\\\"_blank\\\"\\u003emax.com\\u003c/a\\u003e. Online account registration may be required. Offer not available to DIRECTV via Satellite and U-verse TV customers switching to DIRECTV via Internet.\",\"tooltip\":[],\"position\":\"\",\"component\":\"content_uf\",\"components\":\"\",\"componentType\":\"h4\",\"inlineLinkStyle\":\"\"}],\"textAlign\":\"center\",\"gridColumn\":[]},{\"id\":\"faqPanel\",\"faq\":[{\"_uid\":\"03bf8065-13d2-43db-bd88-0168e57bbe38\",\"component\":\"FAQ\",\"componentt\":\"h5\",\"INITIALCOUNT\":\"4\",\"array_panels\":[{\"_uid\":\"473825a7-f403-4604-8025-7c6dfa1ac417\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"c86f3a50-2a62-4919-a966-666d1e847cc7\",\"type\":\"\",\"content\":\"DIRECTV STREAM is a subscription streaming service that lets you watch live TV from major broadcast and popular cable networks. Enjoy local and national live sports, breaking news and must see shows the moment they air. Included: unlimited cloud DVR storage space so you can record as many shows as you want and stream them from wherever you go.\\u003cbr /\\u003e\\u003cbr /\\u003e\\n\\u003cspan style=\\\"font-size: 11.0px;\\\"\\u003eNew DIRECTV STREAM customers only. Offer not available to DIRECTV and U-verse TV customers switching to DIRECTV STREAM. Data connection req\u2019d. Recordings expire after 9 months. In a series recording, max 30 episodes stored (oldest deleted first which may be in less than 9 months). Restr\u2019s apply. \\u003c/span\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"38570b9c-8a81-44d4-a84f-e715b4a220a1\",\"type\":\"\",\"content\":\"What is DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"57664977-7f50-422c-b2ca-ef46d9cf9339\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"8f596b3d-aeb9-4987-afa3-d9480d34f15f\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM gives you live and on demand access to top shows like Yellowstone, The Simpsons, The Walking Dead, Grey\u2019s Anatomy, Sports Center, FOX NFL Sunday, Good Morning America, The Rachel Maddow Show, Atlanta, Dateline, Family Guy, Law \\u0026amp; Order SVU, The Voice... and the list keeps growing.\\u003c/p\\u003e\\n\\u003cp\\u003eFor even more entertainment check out \\u003ca href=\\\"https://www.directv.com/insider/\\\" style=\\\"background-color: rgb(255, 255, 255);\\\"\\u003eDIRECTV Insider\\u003c/a\\u003e where you will get the latest sporting news, exclusive interviews, along with hot trending topics, such as newly released and upcoming movies \\u0026amp; get the latest scoop on TV series, actors, actresses and musicians.\\u003cbr\\u003e\\n\\u003c/p\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"88a78338-ec45-4821-9058-f1881da2f7e1\",\"content\":\"What are some shows I can watch on DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"7edbce6c-9614-4446-be8e-05abce8194de\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"007e6e70-b2fa-483c-9937-52a86861d42c\",\"type\":\"\",\"content\":\"To watch Major League Baseball games without cable, just start a free trial of DIRECTV STREAM. You can start watching immediately on your television, phone, computer \\u0026 more by downloading the DIRECTV STREAM app. There is no commitment or contract.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"e27f52a3-e81a-409e-bdef-bbaeace64ef9\",\"content\":\"How can I watch the MLB baseball games online without cable?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"d7f3a288-c904-43e0-a079-81f03a376158\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"06e3fa54-cd5a-4c3d-8b54-3aa526c5785f\",\"type\":\"\",\"content\":\"Absolutely! Not only does DIRECTV STREAM have NFL, NBA, and MLB games, but you can also watch NHL, NASCAR, MLS, golf tennis, boxing, MMA, college sports and more. Plus, we have every major golf, tennis major and Triple Crown races as well as full coverage of specials like the World Series, NBA Finals, Stanley Cup Playoffs and Olympics.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"a26f20f5-77c3-4887-b43e-a4357adeadb3\",\"content\":\"Are leagues like the NFL, NBA, MLB and others available? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"b794607d-5766-44ff-b1f9-709736b6695f\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"14bcddb1-d69d-470b-9e7e-d3b1535a7f58\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM is available currently in the United States. All packages include cloud DVR storage and there are no hidden fees, equipment rentals or installation appointments required. All that is needed\\u0026nbsp;to get started is:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eA mobile phone number or email address\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA future payment method\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA broadband internet connection\\u0026nbsp;\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA supported streaming device\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"bfaef44e-d257-4695-a252-bdc53197a7ea\",\"content\":\"Is DIRECTV STREAM available where I live?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]},{\"_uid\":\"2310270c-faa5-4cf7-b8a8-a7f048313261\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"e3eedd3a-6a92-4893-b858-024a1c2cf913\",\"content\":\"Amazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nAmazon Fire tablets (4th gen or later)\\u003cbr /\\u003e\\nAndroid TV, phones, and tablets (with OS 5 or later)\\u003cbr /\\u003e\\nApple TV (4th gen or later)\\u003cbr /\\u003e\\nApple iPhone, iPad, and iPod Touch (with iOS 12.2 or later)\\u003cbr /\\u003e\\nCox Contour 2 and Contour Stream Player\\u003cbr /\\u003e\\nLG Smart TV (with webOS 4 or later)\\u003cbr /\\u003e\\nMac computers (with macOS X 10.10 or later)\\u003cbr /\\u003e\\nGoogle Chromebooks (with Chrome browser version 95 or later)\\u003cbr /\\u003e\\nGoogle TV\\u003cbr /\\u003e\\nPC (with Windows 7 or later)\\u003cbr /\\u003e\\nPlayStation 4 and 5\\u003cbr /\\u003e\\nRoku streaming devices (with Roku OS 10 or later)\\u003cbr /\\u003e\\nSamsung TV (2016 models and later)\\u003cbr /\\u003e\\nAmazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nSpectrum WorldBox (in select areas)\\u003cbr /\\u003e\\nVIZIO Smart TV (2018 models and later)\\u003cbr /\\u003e\\nXbox One and Xbox Series X|S\\u003cbr /\\u003e\\nXClass TV\\u003cbr /\\u003e\\nXfinity X1 and Flex\\u003cbr /\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"2be3f0c5-021e-4ed9-8976-c08bd0abaeb6\",\"content\":\"What is a supported streaming device? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]}],\"ADDITIONALCOUNT\":\"7\"}],\"_uid\":\"17d29ffd-06b0-4784-9a64-4ddd6fb6a2a2\",\"type\":\"FAQ\",\"title\":[{\"cta\":[],\"_uid\":\"b3320816-6eb8-447b-b0a0-9f56cac8841a\",\"content\":\"Frequently asked questions\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"spacer\":\"afterHero\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"_uid\":\"73ba3bf7-b2be-44f1-ac78-63a1146ebfcd\",\"component\":\"analytics\",\"contentFriendlyName\":\"Frequently asked questions\",\"contentProductGroup\":\"atttv\"}],\"component\":\"faqPanel\",\"primaryCTA\":[{\"_uid\":\"9b911769-7555-4355-a99b-3282daf8fa01\",\"mode\":\"\",\"type\":\"contained\",\"label\":\"\",\"sizes\":\"large\",\"colors\":\"primary\",\"target\":\"\",\"content\":\"VIEW MORE\",\"variant\":\"\",\"legalUrl\":\"\",\"position\":\"\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"\",\"accessibility\":\"View More\",\"backgroundColor\":\"\"}],\"collapseText\":[{\"cta\":[],\"_uid\":\"66101457-47c2-482f-903c-c896cec889f9\",\"content\":\"COLLAPSE ALL\",\"tooltip\":\"\",\"component\":\"content\"}],\"viewLessText\":[{\"cta\":[],\"_uid\":\"cb1b8c87-b8a3-4f67-850c-f0174de96344\",\"content\":\"SHOW LESS\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"viewMoreText\":[{\"cta\":[],\"