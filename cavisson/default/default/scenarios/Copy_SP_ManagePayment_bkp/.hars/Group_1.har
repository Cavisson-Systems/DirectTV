"_uid\":\"638266fe-510e-4cb1-89e3-668f3ab8c289\",\"mode\":\"\",\"type\":\"heading\",\"label\":\"\",\"content\":\"Pick up where you left off?\",\"variant\":\"\",\"ariaLabel\":\"\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"\"},{\"_uid\":\"598bc787-0319-4dac-bd63-9dc72f38a0d2\",\"mode\":\"\",\"type\":\"subHeading\",\"label\":\"\",\"content\":\"Do you want to continue with the choices you made earlier?\",\"variant\":\"\",\"ariaLabel\":\"\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"\"},{\"_uid\":\"58105f5f-d9a0-424f-9725-d652f8186f78\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"Yes, keep my earlier choices\",\"content\":\"\",\"variant\":\"\",\"ariaLabel\":\"Yes, keep my earlier choices\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"anchorLink\"},{\"_uid\":\"3659988c-b68a-4ca1-8f88-bfd7615d69b6\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"No, I will start over\",\"content\":\"\",\"variant\":\"uxsecondary\",\"ariaLabel\":\"No, I will start over\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"closeModal\"}]}]},{\"id\":\"inPageLegal4-2up\",\"_uid\":\"295e5547-643d-44f6-925d-672c2a15ab3f\",\"type\":\"INPAGELEGAL\",\"align\":\"center\",\"legalUrl\":\"\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"url\":\"\",\"_uid\":\"6c6341bc-f443-4dcf-9f02-144f84d88c5c\",\"linkName\":\"\",\"component\":\"analytics_uf\",\"linkPosition\":\"\",\"linkDestinationUrl\":\"\",\"contentFriendlyName\":\"TV-ATTTV-Default-Hero--NBALP-Q2-21\",\"contentProductGroup\":\"ATTTV\"}],\"component\":\"inPageLegal_uf\",\"legalText\":[{\"cta\":[{\"_uid\":\"5949b916-cc2a-488d-905b-1038f39ce545\",\"mode\":\"\",\"type\":\"\",\"label\":\" Offer details\",\"sizes\":\"\",\"colors\":\"\",\"target\":\"\",\"content\":\"\",\"variant\":\"\",\"legalUrl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"position\":\"inline\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"accessibility\":\"\",\"backgroundColor\":\"\"}],\"_uid\":\"223ef2a5-8552-486e-b05b-0abe81cbdd95\",\"type\":\"\",\"content\":\"*Max, SHOWTIME, STARZ, MGM+ and Cinemax auto-renew after 3 months at then prevailing rates (currently $17.99/mo. for Max, $11.00/mo. each for SHOWTIME, STARZ and Cinemax, and $6.00/mo. for MGM+), unless you change or cancel. Req\u2019s you to select offer. Offer subject to change \\u0026 may be modified or discontinued at any time without notice. Max is used under license. Access Max only through Max app or \\u003ca href=\\\"https://www.max.com/\\\" target=\\\"_blank\\\"\\u003emax.com\\u003c/a\\u003e. Online account registration may be required. Offer not available to DIRECTV via Satellite and U-verse TV customers switching to DIRECTV via Internet.\",\"tooltip\":[],\"position\":\"\",\"component\":\"content_uf\",\"components\":\"\",\"componentType\":\"h4\",\"inlineLinkStyle\":\"\"}],\"textAlign\":\"center\",\"gridColumn\":[]},{\"id\":\"faqPanel\",\"faq\":[{\"_uid\":\"d25872f7-c250-4070-b61c-b3d3697b0f17\",\"component\":\"FAQ\",\"componentt\":\"h5\",\"INITIALCOUNT\":\"4\",\"array_panels\":[{\"_uid\":\"bd4699b3-c5c8-445a-9d73-5615126fc4d3\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"99d69d5c-2251-448e-a713-f3081b7709ee\",\"type\":\"\",\"content\":\"DIRECTV STREAM is a subscription streaming service that lets you watch live TV from major broadcast and popular cable networks. Enjoy local and national live sports, breaking news and must see shows the moment they air. Included: unlimited cloud DVR storage space so you can record as many shows as you want and stream them from wherever you go.\\u003cbr /\\u003e\\u003cbr /\\u003e\\n\\u003cspan style=\\\"font-size: 11.0px;\\\"\\u003eNew DIRECTV STREAM customers only. Offer not available to DIRECTV and U-verse TV customers switching to DIRECTV STREAM. Data connection req\u2019d. Recordings expire after 9 months. In a series recording, max 30 episodes stored (oldest deleted first which may be in less than 9 months). Restr\u2019s apply. \\u003c/span\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"34cfbb3d-7dab-4bc9-8b0b-dc8e0aa312f5\",\"type\":\"\",\"content\":\"What is DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"ae053d03-b21c-4012-8002-ca9776126bd6\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"8afa5e74-ce1e-45f2-b92e-075afbfc776f\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM gives you live and on demand access to top shows like Yellowstone, The Simpsons, The Walking Dead, Grey\u2019s Anatomy, Sports Center, FOX NFL Sunday, Good Morning America, The Rachel Maddow Show, Atlanta, Dateline, Family Guy, Law \\u0026amp; Order SVU, The Voice... and the list keeps growing.\\u003c/p\\u003e\\n\\u003cp\\u003eFor even more entertainment check out \\u003ca href=\\\"https://www.directv.com/insider/\\\" style=\\\"background-color: rgb(255, 255, 255);\\\"\\u003eDIRECTV Insider\\u003c/a\\u003e where you will get the latest sporting news, exclusive interviews, along with hot trending topics, such as newly released and upcoming movies \\u0026amp; get the latest scoop on TV series, actors, actresses and musicians.\\u003cbr\\u003e\\n\\u003c/p\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"7716aaf1-c2c5-4b61-97a7-9c8f957be2f8\",\"content\":\"What are some shows I can watch on DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"93f10590-1f76-4465-a25f-d778f5b551c2\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"cdcb823c-09e7-470a-9b1f-d19076aacaa7\",\"type\":\"\",\"content\":\"To watch Major League Baseball games without cable, just start a free trial of DIRECTV STREAM. You can start watching immediately on your television, phone, computer \\u0026 more by downloading the DIRECTV STREAM app. There is no commitment or contract.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"efb6ed3e-a6e3-4233-b727-c3fdedf5bedf\",\"content\":\"How can I watch the MLB baseball games online without cable?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"9779d1ab-bc1e-4757-aceb-91d3174660e3\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"f91d9e51-824a-4925-99c7-63ad325dec64\",\"type\":\"\",\"content\":\"Absolutely! Not only does DIRECTV STREAM have NFL, NBA, and MLB games, but you can also watch NHL, NASCAR, MLS, golf tennis, boxing, MMA, college sports and more. Plus, we have every major golf, tennis major and Triple Crown races as well as full coverage of specials like the World Series, NBA Finals, Stanley Cup Playoffs and Olympics.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"cfa16e36-042d-4b35-9c91-4a29e6d461ab\",\"content\":\"Are leagues like the NFL, NBA, MLB and others available? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"5f8f4518-bf61-4f7e-a8da-ad3acf70456d\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"a0e67a11-1931-42f1-af1e-ca218ba464cf\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM is available currently in the United States. All packages include cloud DVR storage and there are no hidden fees, equipment rentals or installation appointments required. All that is needed\\u0026nbsp;to get started is:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eA mobile phone number or email address\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA future payment method\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA broadband internet connection\\u0026nbsp;\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA supported streaming device\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"c88d61b8-9798-498a-af17-2f5300bfec78\",\"content\":\"Is DIRECTV STREAM available where I live?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]},{\"_uid\":\"a49ecb58-c69a-4fb4-878a-e20e8c7bbfea\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"2e0858a6-b0c4-4b08-92e3-0f74c23fc2fe\",\"content\":\"Amazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nAmazon Fire tablets (4th gen or later)\\u003cbr /\\u003e\\nAndroid TV, phones, and tablets (with OS 5 or later)\\u003cbr /\\u003e\\nApple TV (4th gen or later)\\u003cbr /\\u003e\\nApple iPhone, iPad, and iPod Touch (with iOS 12.2 or later)\\u003cbr /\\u003e\\nCox Contour 2 and Contour Stream Player\\u003cbr /\\u003e\\nLG Smart TV (with webOS 4 or later)\\u003cbr /\\u003e\\nMac computers (with macOS X 10.10 or later)\\u003cbr /\\u003e\\nGoogle Chromebooks (with Chrome browser version 95 or later)\\u003cbr /\\u003e\\nGoogle TV\\u003cbr /\\u003e\\nPC (with Windows 7 or later)\\u003cbr /\\u003e\\nPlayStation 4 and 5\\u003cbr /\\u003e\\nRoku streaming devices (with Roku OS 10 or later)\\u003cbr /\\u003e\\nSamsung TV (2016 models and later)\\u003cbr /\\u003e\\nAmazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nSpectrum WorldBox (in select areas)\\u003cbr /\\u003e\\nVIZIO Smart TV (2018 models and later)\\u003cbr /\\u003e\\nXbox One and Xbox Series X|S\