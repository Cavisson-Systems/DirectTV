ice\",\"titleCard\":\"We want you back!\",\"seasonalTitle\":\"Upgrade to paid service and catch football\u2019s hottest games\",\"mayBeLaterBtn\":\"Maybe later\",\"description\":\"Your paid service was canceled on [[serviceEndDate]]. Restart now and enhance your TV experience-or check out a new high-value TV package.\",\"seasonalDescription\":\"Your paid service was canceled on [[serviceEndDate]]. But now it's blitz season for college bowl games, NFL playoffs\u2014and the Big Game. Come back and score ESPN, ABC, and more.\",\"bannerImg\":\"/dtvassets/service/images/ffp/ffp_fam_football.png\"},\"servicesNotEligibleReconnectCard\":{\"nonSeasonalBanner\":\"/dtvassets/service/images/ffp/ffp_non-seasonal-backup.png\",\"ctaButton\":\"Explore TV packages\",\"titleCard\":\"Want more sports, more live content\u2014more everything?\",\"seasonalTitle\":\"Upgrade to paid service and catch football\u2019s hottest games\",\"description\":\"We've got a paid TV package that's perfect for your family and budget.\",\"seasonalDescription\":\"Your paid service was canceled on [[serviceEndDate]]. But now it's blitz season for college bowl games, NFL playoffs\u2014and the Big Game. Come back and score ESPN, ABC, and more.\",\"bannerImg\":\"/dtvassets/service/images/ffp/ffp_fam_football.png\"}},\"title\":\"reconnectCard\"}}},\"freemiumCard\":{\"title\":\"freemiumCard\",\"elements\":{\"freemiumBanner\":{\"ctaButton\":\"WATCH NOW\",\"freemiumImg\":\"/public/images/FreeFrontPorch/MicrosoftTeams-image.png \",\"titleCard\":\"FREEMIUM\",\"buttonLink\":\"https://www.google.com/\",\"description\":\"DIRECTV Front Porch offers a great selection of 100% free shows and movies. No charge, no obligation-check it out! \",\"channelbutton\":\"See Channel lineup\",\"ctaLink\":\"  \"}}},\"infoSupportCard\":{\"title\":\"infoSupportCard\",\"elements\":{\"supportBanner\":{\"titleCard\":\"INFO AND SUPPORT\",\"accessLink\":\"https://www.google.com/\",\"accessName\":\"How to access your purchased content\",\"watc