,\"variant\":\"\",\"ariaLabel\":\"\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"\"},{\"_uid\":\"60bf0f0b-e7f3-4d74-af69-7c556d740f9c\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"Yes, keep my earlier choices\",\"content\":\"\",\"variant\":\"\",\"ariaLabel\":\"Yes, keep my earlier choices\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"anchorLink\"},{\"_uid\":\"1228e0d2-368d-46cf-abfe-b34ec414648f\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"No, I will start over\",\"content\":\"\",\"variant\":\"uxsecondary\",\"ariaLabel\":\"No, I will start over\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"closeModal\"}]}]},{\"id\":\"inPageLegal4-2up\",\"_uid\":\"09d89295-3ea2-483d-9dbb-33c7ac94468d\",\"type\":\"INPAGELEGAL\",\"align\":\"center\",\"legalUrl\":\"\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"url\":\"\",\"_uid\":\"55c96268-c3fd-4863-a09e-944f6f649984\",\"linkName\":\"\",\"component\":\"analytics_uf\",\"linkPosition\":\"\",\"linkDestinationUrl\":\"\",\"contentFriendlyName\":\"TV-ATTTV-Default-Hero--NBALP-Q2-21\",\"contentProductGroup\":\"ATTTV\"}],\"component\":\"inPageLegal_uf\",\"legalText\":[{\"cta\":[{\"_uid\":\"b63cc70d-f2ae-4f71-8385-0efeb9cd7fa3\",\"mode\":\"\",\"type\":\"\",\"label\":\" Offer details\",\"sizes\":\"\",\"colors\":\"\",\"target\":\"\",\"content\":\"\",\"variant\":\"\",\"legalUrl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"position\":\"inline\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"accessibility\":\"\",\"backgroundColor\":\"\"}],\"_uid\":\"f86b56f6-4263-45b3-a0dc-aa9e82bef661\",\"type\":\"\",\"content\":\"*Max, SHOWTIME, STARZ, MGM+ and Cinemax auto-renew after 3 months at then prevailing rates (currently $17.99/mo. for Max, $11.00/mo. each for SHOWTIME, STARZ and Cinemax, and $6.00/mo. for MGM+), unless you change or cancel. Req\u2019s you to select offer. Offer subject to change \\u0026 may be modified or discontinued at any time without notice. Max is used under license. Access Max only through Max app or \\u003ca href=\\\"https://www.max.com/\\\" target=\\\"_blank\\\"\\u003emax.com\\u003c/a\\u003e. Online account registration may be required. Offer not available to DIRECTV via Satellite and U-verse TV customers switching to DIRECTV via Internet.\",\"tooltip\":[],\"position\":\"\",\"component\":\"content_uf\",\"components\":\"\",\"componentType\":\"h4\",\"inlineLinkStyle\":\"\"}],\"textAlign\":\"center\",\"gridColumn\":[]},{\"id\":\"faqPanel\",\"faq\":[{\"_uid\":\"3a5eb7a8-3836-4f2b-96fb-4ef5ed31aae1\",\"component\":\"FAQ\",\"componentt\":\"h5\",\"INITIALCOUNT\":\"4\",\"array_panels\":[{\"_uid\":\"d3a01723-21f0-4fbc-80d7-4c089d07668d\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"fee9f512-6008-4afd-8be3-05d4463d05ab\",\"type\":\"\",\"content\":\"DIRECTV STREAM is a subscription streaming service that lets you watch live TV from major broadcast and popular cable networks. Enjoy local and national live sports, breaking news and must see shows the moment they air. Included: unlimited cloud DVR storage space so you can record as many shows as you want and stream them from wherever you go.\\u003cbr /\\u003e\\u003cbr /\\u003e\\n\\u003cspan style=\\\"font-size: 11.0px;\\\"\\u003eNew DIRECTV STREAM customers only. Offer not available to DIRECTV and U-verse TV customers switching to DIRECTV STREAM. Data connection req\u2019d. Recordings expire after 9 months. In a series recording, max 30 episodes stored (oldest deleted first which may be in less than 9 months). Restr\u2019s apply. \\u003c/span\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"3b7d4728-b119-4b81-8cb2-61ae6368481b\",\"type\":\"\",\"content\":\"What is DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"f7f2e157-ecb5-4d27-826e-57293ef0b2de\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"327e386c-64f1-454b-bcc5-26b5ec8fea72\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM gives you live and on demand access to top shows like Yellowstone, The Simpsons, The Walking Dead, Grey\u2019s Anatomy, Sports Center, FOX NFL Sunday, Good Morning America, The Rachel Maddow Show, Atlanta, Dateline, Family Guy, Law \\u0026amp; Order SVU, The Voice... and the list keeps growing.\\u003c/p\\u003e\\n\\u003cp\\u003eFor even more entertainment check out \\u003ca href=\\\"https://www.directv.com/insider/\\\" style=\\\"background-color: rgb(255, 255, 255);\\\"\\u003eDIRECTV Insider\\u003c/a\\u003e where you will get the latest sporting news, exclusive interviews, along with hot trending topics, such as newly released and upcoming movies \\u0026amp; get the latest scoop on TV series, actors, actresses and musicians.\\u003cbr\\u003e\\n\\u003c/p\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"efae4913-badc-4b93-8621-61a993c0f1db\",\"content\":\"What are some shows I can watch on DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"45477c86-33d9-4fbd-b05a-eecb2f08f9ad\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"c7bcfe37-c61f-4895-84f3-8967f24c56dd\",\"type\":\"\",\"content\":\"To watch Major League Baseball games without cable, just start a free trial of DIRECTV STREAM. You can start watching immediately on your television, phone, computer \\u0026 more by downloading the DIRECTV STREAM app. There is no commitment or contract.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"ca349d76-fa70-4e6f-9410-d9b4a3971c36\",\"content\":\"How can I watch the MLB baseball games online without cable?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"f1a4318d-5ef1-4836-86d5-da51d57b9940\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"a0276b73-64c4-4547-9c05-e27cc102101f\",\"type\":\"\",\"content\":\"Absolutely! Not only does DIRECTV STREAM have NFL, NBA, and MLB games, but you can also watch NHL, NASCAR, MLS, golf tennis, boxing, MMA, college sports and more. Plus, we have every major golf, tennis major and Triple Crown races as well as full coverage of specials like the World Series, NBA Finals, Stanley Cup Playoffs and Olympics.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"31817366-be67-4044-8e2f-d63cb1567c74\",\"content\":\"Are leagues like the NFL, NBA, MLB and others available? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"55d1d3e8-89bd-4beb-aa43-ce5359d40713\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"2a5f9c95-bc25-45f6-87bd-e42137694f9b\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM is available currently in the United States. All packages include cloud DVR storage and there are no hidden fees, equipment rentals or installation appointments required. All that is needed\\u0026nbsp;to get started is:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eA mobile phone number or email address\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA future payment method\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA broadband internet connection\\u0026nbsp;\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA supported streaming device\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"a0ddce69-235d-4ba0-9292-e94931bb64c5\",\"content\":\"Is DIRECTV STREAM available where I live?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]},{\"_uid\":\"0dd94a50-e776-4b0a-a1d1-e8153594bf7f\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"6ae9bc52-7969-458f-b527-930ec367cd4e\",\"content\":\"Amazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nAmazon Fire tablets (4th gen or later)\\u003cbr /\\u003e\\nAndroid TV, phones, and tablets (with OS 5 or later)\\u003cbr /\\u003e\\nApple TV (4th gen or later)\\u003cbr /\\u003e\\nApple iPhone, iPad, and iPod Touch (with iOS 12.2 or later)\\u003cbr /\\u003e\\nCox Contour 2 and Contour Stream Player\\u003cbr /\\u003e\\nLG Smart TV (with webOS 4 or later)\\u003cbr /\\u003e\\nMac computers (with macOS X 10.10 or later)\\u003cbr /\\u003e\\nGoogle Chromebooks (with Chrome browser version 95 or later)\\u003cbr /\\u003e\\nGoogle TV\\u003cbr /\\u003e\\nPC (with Windows 7 or later)\\u003cbr /\\u003e\\nPlayStation 4 and 5\\u003cbr /\\u003e\\nRoku streaming devices (with Roku OS 10 or later)\\u003cbr /\\u003e\\nSamsung TV (2016 models and later)\\u003cbr /\\u003e\\nAmazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nSpectrum WorldBox (in select areas)\\u003cbr /\\u003e\\nVIZIO Smart TV (2018 models and later)\\u003cbr /\\u003e\\nXbox One and Xbox Series X|S\\u003cbr /\\u003e\\nXClass TV\\u003cbr /\\u003e\\nXfinity X1 and Flex\\u003cbr /\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"00b4835e-db45-4043-aa09-97ce1b8c3960\",\"content\":\"What is a supported streaming device? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]}],\"ADDITIONALCOUNT\":\"7\"}],\"_uid\":\"effae3b3-6af3-42ab-8294-84376ca400c7\",\"type\":\"FAQ\",\"title\":[{\"cta\":[],\"_uid\":\"df38cc8a-2d7a-479e-9ceb-9ed9c5eed29b\",\"content\":\"Frequently asked questions\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"spacer\":\"afterHero\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"_uid\":\"8ad0bae8-ff86-4c6d-9642-46f026157b13\",\"component\":\"analytics\",\"contentFriendlyName\":\"Frequently asked questions\",\"contentProductGroup\":\"atttv\"}],\"component\":\"faqPanel\",\"primaryCTA\":[{\"_uid\":\"33814be8-83e9-4f7a-87e4-4c32885cd7ec\",\"mode\":\"\",\"type\":\"contained\",\"label\":\"\",\"sizes\":\"large\",\"colors\":\"primary\",\"target\":\"\",\"content\":\"VIEW MORE\",\"variant\":\"\",\"legalUrl\":\"\",\"position\":\"\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"\",\"accessibility\":\"View More\",\"backgroundColor\":\"\"}],\"collapseText\":[{\"cta\":[],\"_uid\":\"2649c1f9-46e0-48ce-8362-e326606a1038\",\"content\":\"COLLAPSE ALL\",\"tooltip\":\"\",\"component\":\"content\"}],\"viewLessText\":[{\"cta\":[],\"_uid\":\"3e35d977-80a0-4ecd-848c-cff9cd931664\",\"content\":\"SHOW LESS\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"viewMoreText\":[{\"cta\":[],\"_uid\":\"ed6cba4f-08ab-48f1-b8c7-4f3d4d485f1b\",\"content\":\"SHOW MORE\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]}],\"packageType\":\"Basic Service\",\"promotionId\":\"\",\"offerRackRate\":\"223\"},{\"_uid\":\"e137509b-915f-4a40-b818-f74bac26b746\",\"Biller\":\"STMS\",\"component\":\"Biller\",\"offerCode\":\"OF_INSURANCE-PROTECTION-PLAN-V6_satellite\",\"serviceId\":\"xyz\",\"components\":[{\"id\":\"contentCard-v9\",\"_uid\":\"a8411a50-694c-4028-bb0d-facbaf806296\",\"type\":\"CONTENTCARDS\",\"spacer\":\"\",\"analytics\":[],\"component\":\"dtvCont