er7\" data-section=\"VerticalSpacer7\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalSpacer MuiBox-root mui-style-4nm4jb\"></div></div></section><section id=\"dtv2-VerticalSpacer8\" data-section=\"VerticalSpacer8\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalSpacer-review MuiBox-root mui-style-4nm4jb\"></div></div></section><section id=\"dtv2-VerticalSpacer9\" data-section=\"VerticalSpacer9\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalspacer3 MuiBox-root mui-style-1f6hpzw\"></div></div></section><section id=\"dtv2-VerticalSpacer10\" data-section=\"VerticalSpacer10\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalspacer3 MuiBox-root mui-style-q4l2b\"></div></div></section><section id=\"dtv2-VerticalSpacer11\" data-section=\"VerticalSpacer11\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalspacer5 MuiBox-root mui-style-1f6hpzw\"></div></div></section><section id=\"dtv2-contentCard-v2\" data-section=\"contentCard-v2\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"MuiBox-root mui-style-2e2z4a\"><div class=\"MuiGrid-root MuiGrid-container mui-style-4dkg30\"> <div class=\"MuiGrid-root MuiGrid-item MuiGrid-grid-xs-12 MuiGrid-grid-md-12 mui-style-yxfjrw\"> <div class=\"MuiBox-root mui-style-acwik3\"><div class=\"MuiBox-root mui-style-122zt5t\"><picture><source media=\"(min-width: 1199px)\"srcSet=\"/assets/content/5k5j4ttvrl/web/5803951_dsk-v2.png?noretina=true 1x, /assets/content/5k5j4ttvrl/web/5803951_dsk-v2.png 2x\"/><source media=\"(min-width: 600px)\"srcSet=\"/assets/content/kskczrwo3u/web/94df9022-f2d2-421a-be5d-2cc99e827e25.png?imwidth=900&amp;noretina=true 1x, /assets/content/kskczrwo3u/web/94df9022-f2d2-421a-be5d-2cc99e827e25.png?imwidth=900 2x\"/><img alt=\"Ronald McDonald House logo and DIRECTV logo side by side.\" id=\"card-image-1up-contentCard-v2-0\" loading=\"lazy\"srcSet=\"/assets/content/3tyzoijrjp/web/5803951_mbl-v3.png?imwidth=600&amp;noretina=true 1x, /assets/content/3tyzoijrjp/web/5803951_mbl-v3.png?imwidth=600 2x\" style=\"margin-top:0px;width:100%;height:100%;object-fit:cover;border-radius:10px\"/></picture></div><div class=\"MuiBox-root mui-style-1u3xtm4\"><div class=\"MuiTypography-root MuiTypography-subhead1medium mui-style-1sqilva\" aria-label=\"DIRECTV is a proud supporter of Ronald McDonald House\u00ae, helping keep families together when they need it most.\" id=\"card-headline\">DIRECTV is a proud supporter of Ronald McDonald House\u00ae, helping keep families together when they need it most.</div><div class=\"contentCard-v2-cta-container MuiBox-root mui-style-u8iygj\"><div class=\"contentCard-v2-cta1 MuiBox-root mui-style-5muwwy\"><a class=\"MuiButtonBase-root MuiButton-root MuiButton-uxprimary MuiButton-uxprimaryPrimary MuiButton-sizeMedium MuiButton-uxprimarySizeMedium MuiButton-colorPrimary MuiButton-root MuiButton-uxprimary MuiButton-uxprimaryPrimary MuiButton-sizeMedium MuiButton-uxprimarySizeMedium MuiButton-colorPrimary mui-style-1mmt9l5\" tabindex=\"0\" aria-label=\"learn more\" id=\"card-cta-contentCard-v2-undefined\" href=\"https://ronaldmcdonaldhouse.org/\" role=\"button\" target=\"_self\" data-linkPosition=\"body\" data-linkDestination=\"https://ronaldmcdonaldhouse.org/\"><span>Learn More</span></a></div></div></div></div> </div> </div></div></div></section><section id=\"dtv2-VerticalSpacer13\" data-section=\"VerticalSpacer13\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalspacer5 MuiBox-root mui-style-1f6hpzw\"></div></div></section><section id=\"dtv2-inpagelegal\" data-section=\"inpagelegal\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"inpagelegal-legal-content MuiBox-root mui-style-1h8jnau\"><div class=\"MuiGrid-root MuiGrid-container mui-style-n3cyzi\"> <div class=\"MuiGrid-root MuiGrid-item MuiGrid-grid-xs-12 MuiGrid-grid-sm-9 MuiGrid-grid-md-10 MuiGrid-grid-lg-10 MuiGrid-grid-xl-10 mui-style-1x77vny\"> <aside class=\"MuiTypography-root MuiTypography-smalltext mui-style-1tgr8f3\" id=\"inpagelegal-text\">\u00b9New customers only. Includes free trial, followed by 2 mo. promo; thereafter svc auto-renews monthly at then-prevailing rates unless you cancel. Cancel anytime. ESPN Unlimited: Restr\u2019s apply. Availability of channels varies based on package selection. Cancel anytime. CBS not available in select markets.<br/>ESPN Unlimited, Disney +, and Hulu: Must be 18+. This will not replace any existing Disney+, Hulu, ESPN, or Disney bundle subscription you may already have. All other accounts must be managed separately. You must remain on an eligible plan to retain your offer.</aside> </div> </div></div></div></section><section id=\"dtv2-inpagelegal-2\" data-section=\"inpagelegal-2\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"inpagelegal-2-legal-content MuiBox-root mui-style-1h8jnau\"><div class=\"MuiGrid-root MuiGrid-container mui-style-n3cyzi\"> <div class=\"MuiGrid-root MuiGrid-item MuiGrid-grid-xs-12 MuiGrid-grid-sm-9 MuiGrid-grid-md-10 MuiGrid-grid-lg-10 MuiGrid-grid-xl-10 mui-style-1x77vny\"> <aside class=\"MuiTypography-root MuiTypography-smalltext mui-style-1tgr8f3\" id=\"inpagelegal-2-text\">\u00b2New approved DIRECTV resid. customers new to Spotify Premium only. Offer applies to Spotify Premium Individual. Spotify Premium at no charge for first 4 months; auto-renews monthly after 4-mo. trial at then-prevailing rate (currently $11.99/mo.) unless canceled at\u202f<a class=\"MuiButtonBase-root MuiButton-root MuiButton-uxtextdark MuiButton-uxtextdarkPrimary MuiButton-sizeMedium MuiButton-uxtextdarkSizeMedium MuiButton-colorPrimary MuiButton-disableElevation MuiButton-root MuiButton-uxtextdark MuiButton-uxtextdarkPrimary MuiButton-sizeMedium MuiButton-uxtextdarkSizeMedium MuiButton-colorPrimary MuiButton-disableElevation mui-style-d143nv\" tabindex=\"0\" href=\"https://www.spotify.com\" target=\"_blank\">spotify.com.</a> Cancel anytime.\u202f<a class=\"MuiButtonBase-root MuiButton-root MuiButton-uxtextdark MuiButton-uxtextdarkPrimary MuiButton-sizeMedium MuiButton-uxtextdarkSizeMedium MuiButton-colorPrimary MuiButton-disableElevation MuiButton-root MuiButton-uxtextdark MuiButton-uxtextdarkPrimary MuiButton-sizeMedium MuiButton-uxtextdarkSizeMedium MuiButton-colorPrimary MuiButton-disableElevation mui-style-d143nv\" tabindex=\"0\" href=\"https://www.spotify.com/us/legal/paid-subscription-terms/\" target=\"_blank\">Terms apply.</a></aside> </div> </div></div></div></section><section id=\"dtv2-inpagelegal-3\" data-section=\"inpagelegal-3\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"inpagelegal-3-legal-content MuiBox-root mui-style-1h8jnau\"><div class=\"MuiGrid-root MuiGrid-container mui-style-n3cyzi\"> <div class=\"MuiGrid-root MuiGrid-item MuiGrid-grid-xs-12 MuiGrid-grid-sm-9 MuiGrid-grid-md-10 MuiGrid-grid-lg-10 MuiGrid-grid-xl-10 mui-style-1x77vny\"> <aside class=\"MuiTypography-root MuiTypography-smalltext mui-style-1tgr8f3\" id=\"inpagelegal-3-text\">\u00b3Internet connection and separate paid subscriptions required to access third party apps  not included in your DIRECTV package. Restr&#x27;s apply. Gemini Air not required for ESPN Unlimited with Streaming Packages.</aside> </div> </div></div></div></section><section id=\"dtv2-VerticalSpacer17\" data-section=\"VerticalSpacer17\" style=\"content-visibility:auto\"><div class=\"MuiBox-root mui-style-x6xv8k\"><div class=\"verticalSpacer MuiBox-root mui-style-4nm4jb\"></div></div></section></div></main><aside><div class=\"MuiBox-root mui-style-5r2njw\" id=\"linkFarm\"><span class=\"MuiBox-root mui-style-1a8k11f\"><svg xmlns=\"http://www.w3.org/2000/svg\" alt=\