,\"buttonSaveCTA\":\"Save changes\",\"currentUserIdLabel\":\"Current user ID\",\"userIdAlreadyExistMsg\":\"This user ID already exists.\",\"useridinfonote\":\"Your user ID can contain upper and lower case letters, numbers, period(.), underscore(_), dash(-), and at symbol(@), but can\u2019t contain 2 consecutive special characters.\",\"buttonCancelCTA\":\"Cancel\"},\"emailVerificationModal\":{\"modalTitle\":\"We\u2019re sorry but we don\u2019t have your email on file\",\"modalContent\":\"To create a PIN, we need to be able to send a validation code to your email on file. Please go to Profile and setup a contact email to proceed.\",\"buttonProfileCTA\":\"GO TO PROFILE\",\"buttonCancelCTA\":\"CANCEL\"},\"permissionsAndPrivacy\":{\"txtManagesettings\":\"CHANGE SETTINGS\",\"txtPageHeading\":\"PARENTAL CONTROLS \\u0026 PRIVACY\",\"txtDisableControls\":\"DISABLE ALL\",\"setUpReceiverOrDVR\":{\"txtLearnMore\":\"LEARN MORE\",\"txtDetailsParentalRatings\":[\"Select a show or movie.\",\"Press INFO on your remote.\",\"Scroll right to Parental.\",\"Select Parental Controls.\"],\"lnkLearnMore\":\"https://www.directv.com/support/satellite/article/KM1010815/\",\"title\":\"On your receiver/DVR\",\"txtheadingParentalRatings\":\"To view parental ratings on a DIRECTV HD receiver or HD DVR:\"},\"setUpDIRECTV\":{\"txtCurrentSetting\":\"\\u003cb\\u003eParental controls [[status]]\\u003c/b\\u003e\",\"txtWatchingOnDIRECTV\":\"You can enable and disable controls for DIRECTV.com. You can also set specific parental controls by using set specific settings.\",\"title\":\"On DIRECTV.com\"},\"txtEnableControls\":\"Enable settings\",\"parentalControls\":{\"txtheading1\":\"Parental controls are available on every receiver and allows you to restrict unsupervised TV viewing based  on rating, block specific channels, limit viewing times, set spending limits for DIRECTV CINEMA movies or Pay-Per-views envents.\",\"txtDetails\":[\"Restrict unsupervised TV viewing based on rating.\",\"Block specific channe