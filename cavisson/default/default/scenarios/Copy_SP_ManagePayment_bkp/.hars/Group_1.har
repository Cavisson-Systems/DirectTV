:\"\",\"variant\":\"\",\"ariaLabel\":\"Yes, keep my earlier choices\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"anchorLink\"},{\"_uid\":\"408f4ed0-ec31-4eb1-9884-3e50acca4fc8\",\"mode\":\"dark\",\"type\":\"cta\",\"label\":\"No, I will start over\",\"content\":\"\",\"variant\":\"uxsecondary\",\"ariaLabel\":\"No, I will start over\",\"component\":\"pageLoadModalData\",\"ctaAction\":\"closeModal\"}]}]},{\"id\":\"inPageLegal4-2up\",\"_uid\":\"35aac98b-b2db-4d52-8eec-a5365b55bc3e\",\"type\":\"INPAGELEGAL\",\"align\":\"center\",\"legalUrl\":\"\",\"analytics\":[{\"id\":\"\",\"tag\":\"\",\"url\":\"\",\"_uid\":\"b5fc7c53-5989-4e83-b483-64b47a33d984\",\"linkName\":\"\",\"component\":\"analytics_uf\",\"linkPosition\":\"\",\"linkDestinationUrl\":\"\",\"contentFriendlyName\":\"TV-ATTTV-Default-Hero--NBALP-Q2-21\",\"contentProductGroup\":\"ATTTV\"}],\"component\":\"inPageLegal_uf\",\"legalText\":[{\"cta\":[{\"_uid\":\"427c8ae9-71a4-45bb-b499-21a4ff6d52dc\",\"mode\":\"\",\"type\":\"\",\"label\":\" Offer details\",\"sizes\":\"\",\"colors\":\"\",\"target\":\"\",\"content\":\"\",\"variant\":\"\",\"legalUrl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"position\":\"inline\",\"analytics\":[],\"component\":\"cta\",\"targeturl\":\"/dtvassets/fragments/dtv/legal/prod/legalcontent/uf/shared/agnostic/legallong_text.model.dtvCF.json\",\"accessibility\":\"\",\"backgroundColor\":\"\"}],\"_uid\":\"1be330b1-5c0d-41ab-9bab-cc099197b3f8\",\"type\":\"\",\"content\":\"*Max, SHOWTIME, STARZ, MGM+ and Cinemax auto-renew after 3 months at then prevailing rates (currently $15.99/mo. for Max, $11.00/mo. each for SHOWTIME, STARZ and Cinemax, and $6.00/mo. for MGM+), unless you change or cancel. Req\u2019s you to select offer. Offer subject to change \\u0026 may be modified or discontinued at any time without notice. Max is used under license. Access Max only through Max app or \\u003ca href=\\\"https://www.max.com/\\\" target=\\\"_blank\\\"\\u003emax.com\\u003c/a\\u003e. Online account registration may be required. Offer not available to DIRECTV via Satellite and U-verse TV customers switching to DIRECTV via Internet.\",\"tooltip\":[],\"position\":\"\",\"component\":\"content_uf\",\"components\":\"\",\"componentType\":\"h4\",\"inlineLinkStyle\":\"\"}],\"textAlign\":\"center\",\"gridColumn\":[]},{\"id\":\"faqPanel\",\"faq\":[{\"_uid\":\"8a097883-8b20-4682-829f-954e8f24d6fa\",\"component\":\"FAQ\",\"componentt\":\"h5\",\"INITIALCOUNT\":\"4\",\"array_panels\":[{\"_uid\":\"bc5c0633-d558-4016-8b46-0f54e8d6cee4\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"8ccdfcbc-4caf-4767-9e24-2b9fc474c1fc\",\"type\":\"\",\"content\":\"DIRECTV STREAM is a subscription streaming service that lets you watch live TV from major broadcast and popular cable networks. Enjoy local and national live sports, breaking news and must see shows the moment they air. Included: unlimited cloud DVR storage space so you can record as many shows as you want and stream them from wherever you go.\\u003cbr /\\u003e\\u003cbr /\\u003e\\n\\u003cspan style=\\\"font-size: 11.0px;\\\"\\u003eNew DIRECTV STREAM customers only. Offer not available to DIRECTV and U-verse TV customers switching to DIRECTV STREAM. Data connection req\u2019d. Recordings expire after 9 months. In a series recording, max 30 episodes stored (oldest deleted first which may be in less than 9 months). Restr\u2019s apply. \\u003c/span\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"e6d9fe06-12e1-4a58-866b-aa41b6a8a22a\",\"type\":\"\",\"content\":\"What is DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"f55a31ce-cc57-49fe-a919-ab573c0f4f96\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"d3e4d2b8-3845-474f-9f63-c8b499c05881\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM gives you live and on demand access to top shows like Yellowstone, The Simpsons, The Walking Dead, Grey\u2019s Anatomy, Sports Center, FOX NFL Sunday, Good Morning America, The Rachel Maddow Show, Atlanta, Dateline, Family Guy, Law \\u0026amp; Order SVU, The Voice... and the list keeps growing.\\u003c/p\\u003e\\n\\u003cp\\u003eFor even more entertainment check out \\u003ca href=\\\"https://www.directv.com/insider/\\\" style=\\\"background-color: rgb(255, 255, 255);\\\"\\u003eDIRECTV Insider\\u003c/a\\u003e where you will get the latest sporting news, exclusive interviews, along with hot trending topics, such as newly released and upcoming movies \\u0026amp; get the latest scoop on TV series, actors, actresses and musicians.\\u003cbr\\u003e\\n\\u003c/p\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"ceff619c-8f18-4bdd-b2a6-ddc006100eb9\",\"content\":\"What are some shows I can watch on DIRECTV STREAM?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"6a1eac3a-4a85-42b3-b95d-70015ce9ac69\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"7f3b6150-17b2-4618-9fb5-75351cf812c6\",\"type\":\"\",\"content\":\"To watch Major League Baseball games without cable, just start a free trial of DIRECTV STREAM. You can start watching immediately on your television, phone, computer \\u0026 more by downloading the DIRECTV STREAM app. There is no commitment or contract.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"3775abd5-065d-4a7f-8204-b4aa1bc936e6\",\"content\":\"How can I watch the MLB baseball games online without cable?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"5b2133cc-3c54-4c27-a3bf-1b2aaab6e4c5\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"79b997e9-bb67-4d91-94d8-830a74be8b42\",\"type\":\"\",\"content\":\"Absolutely! Not only does DIRECTV STREAM have NFL, NBA, and MLB games, but you can also watch NHL, NASCAR, MLS, golf tennis, boxing, MMA, college sports and more. Plus, we have every major golf, tennis major and Triple Crown races as well as full coverage of specials like the World Series, NBA Finals, Stanley Cup Playoffs and Olympics.\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"b8ae787c-7b8e-44ec-9153-769780f7a793\",\"content\":\"Are leagues like the NFL, NBA, MLB and others available? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"h3\"}]},{\"_uid\":\"4dcc3465-1e1f-488f-9322-6ef238db7e9e\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"1a037aba-051e-47b3-b097-f3419d4e239f\",\"content\":\"\\u003cp\\u003eDIRECTV STREAM is available currently in the United States. All packages include cloud DVR storage and there are no hidden fees, equipment rentals or installation appointments required. All that is needed\\u0026nbsp;to get started is:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eA mobile phone number or email address\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA future payment method\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA broadband internet connection\\u0026nbsp;\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003cli\\u003e\\u003cp\\u003eA supported streaming device\\u003c/p\\u003e\\n\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"b6cbe747-9ffd-466c-a42a-851be3630872\",\"content\":\"Is DIRECTV STREAM available where I live?\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]},{\"_uid\":\"cc764e0d-788f-4948-933f-a7d7faf4ecee\",\"component\":\"panels\",\"accordionContent\":[{\"cta\":[],\"_uid\":\"0932d406-1267-4af7-9ed8-0d06a783a3f8\",\"content\":\"Amazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nAmazon Fire tablets (4th gen or later)\\u003cbr /\\u003e\\nAndroid TV, phones, and tablets (with OS 5 or later)\\u003cbr /\\u003e\\nApple TV (4th gen or later)\\u003cbr /\\u003e\\nApple iPhone, iPad, and iPod Touch (with iOS 12.2 or later)\\u003cbr /\\u003e\\nCox Contour 2 and Contour Stream Player\\u003cbr /\\u003e\\nLG Smart TV (with webOS 4 or later)\\u003cbr /\\u003e\\nMac computers (with macOS X 10.10 or later)\\u003cbr /\\u003e\\nGoogle Chromebooks (with Chrome browser version 95 or later)\\u003cbr /\\u003e\\nGoogle TV\\u003cbr /\\u003e\\nPC (with Windows 7 or later)\\u003cbr /\\u003e\\nPlayStation 4 and 5\\u003cbr /\\u003e\\nRoku streaming devices (with Roku OS 10 or later)\\u003cbr /\\u003e\\nSamsung TV (2016 models and later)\\u003cbr /\\u003e\\nAmazon Fire TV devices (with Fire OS 5.1 or later)\\u003cbr /\\u003e\\nSpectrum WorldBox (in select areas)\\u003cbr /\\u003e\\nVIZIO Smart TV (2018 models and later)\\u003cbr /\\u003e\\nXbox One and Xbox Series X|S\\u003cbr /\\u003e\\nXClass TV\\u003cbr /\\u003e\\nXfinity X1 and Flex\\u003cbr /\\u003e\",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}],\"accordionHeading\":[{\"cta\":[],\"_uid\":\"e8f9c1aa-d2ad-4afb-8928-dc49ff90c1c8\",\"content\":\"What is a supported streaming device? \",\"tooltip\":\"\",\"perMonth\":\"\",\"component\":\"content\",\"dollarSign\":\"\",\"componentType\":\"\"}]}],\"ADDITIONALCOUNT\":\"7\"}],\"_uid\":\"30fcecc9-a8d0-458d-bf5f-6c82bcdcb981\",\"type\":\"FAQ\",\"title\":[{\"cta\":[],\"_uid\":\"682870ad-67a7-43bd-beeb-20434049e3de\",\"content\":\"Frequently asked ques